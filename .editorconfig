root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
indent_size = 4

[*.{py}]
indent_size = 4

[*.{xml,yml,yaml,json,gradle}]
indent_size = 4

[*.{js,css,html}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
 <!-- Android 10+ 分区存储：直接读写 /sdcard/Download 需要全文件访问 -->
 <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

 <!-- Android 11+ 包可见性：app.list / app.isInstalled 需要看到全部应用 -->
 <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

 <!-- Android 17 本地网络访问：server.start 8080 / 局域网互访 -->
 <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

    <!-- Android 11+ 包可见性：常用 Intent 与目标包声明 -->
 <queries>
 <!-- 启动器（列出 / 打开所有 App）-->
 <intent>
 <action android:name="android.intent.action.MAIN" />
 <category android:name="android.intent.category.LAUNCHER" />
 </intent>
 <!-- 打开链接 / 文件 -->
 <intent>
 <action android:name="android.intent.action.VIEW" />
 <data android:scheme="https" />
 </intent>
 <intent>
 <action android:name="android.intent.action.VIEW" />
 <data android:scheme="file" />
 </intent>
 <intent>
 <action android:name="android.intent.action.VIEW" />
 <data android:scheme="content" />
 </intent>
 <!-- 安装 APK -->
 <intent>
 <action android:name="android.intent.action.INSTALL_PACKAGE" />
 <data android:scheme="file" />
 </intent>
 <!-- 常用目标包 -->
 <package android:name="com.android.settings" />
 <package android:name="com.android.shell" />
 <package android:name="com.termux" />
 <package android:name="com.termux.api" />
 </queries>
 <application
        android:name=".CrashApp"
        android:largeHeap="true"
 android:allowBackup="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:resizeableActivity="true"
        android:theme="@style/AppTheme">

        <!-- MainActivity: 不锁方向，支持多窗口/分屏/折叠屏 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize">
                <intent-filter>
                    <action android:name="android.intent.action.MAIN" />
                    <category android:name="android.intent.category.LAUNCHER" />
                </intent-filter>
        </activity>

        <!-- 分享入口：透明、不进任务栈；ACTION_PROCESS_TEXT 支持回填 -->
 <activity
 android:name=".ShareActivity"
 android:exported="true"
 android:excludeFromRecents="true"
 android:taskAffinity=""
 android:launchMode="singleInstance"
 android:theme="@style/Theme.Share.Transparent"
 android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density">
 <intent-filter>
 <action android:name="android.intent.action.PROCESS_TEXT" />
 <category android:name="android.intent.category.DEFAULT" />
 <data android:mimeType="text/plain" />
 </intent-filter>
 <intent-filter>
 <action android:name="android.intent.action.SEND" />
 <category android:name="android.intent.category.DEFAULT" />
 <data android:mimeType="text/plain" />
 </intent-filter>
 </activity>

        <activity
            android:name=".PluginActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density"
            android:resizeableActivity="true" />

        <activity
            android:name=".CrashActivity"
            android:exported="false"
            android:process=":crash"
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode"
            android:launchMode="singleInstance" />
    
<!-- UI 自动化无障碍服务 -->

<service android:name=".ZAccessibilityService" android:exported="false" android:label="@string/app_name" android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
<intent-filter>
<action android:name="android.accessibilityservice.AccessibilityService" />
</intent-filter>
<meta-data android:name="android.accessibilityservice" android:resource="@xml/accessibility_service_config" />
</service>

</application>
</manifest>
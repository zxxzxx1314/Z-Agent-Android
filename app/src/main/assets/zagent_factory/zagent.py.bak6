def _is_free_mode():
    try:
        import sys as _s
        m = _s.modules.get("zagent")
        if m is not None and bool(getattr(m, "FREE_MODE", False)):
            return True
    except Exception:
        pass
    return bool(globals().get("FREE_MODE", False))

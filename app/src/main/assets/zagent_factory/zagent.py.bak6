# 4. 心智系统（身份 / 问题队列 / 传记）
# ============================================================
MEMORY_CONFLICT = "MEMORY_CONFLICT"


def file_revision(path):
    """返回文件内容的 SHA-256 前 16 位；文件不存在或读取失败返回空串。"""
    import hashlib
    try:
        with open(path, "rb") as f:
            return hashlib.sha256(f.read()).hexdigest()[:16]
    except Exception:
        return ""

def load_identity() -> str:
    """读取身份核心，注入 System Prompt 最前端。"""
    try:
        with open(IDENTITY_PATH, "r", encoding="utf-8", errors="ignore") as f:
            text = f.read().strip()
    except Exception:
        return ""
    return ("【身份核心（自我定义，可被 [identity] 重写）】\n" + text + "\n") if text else ""


def save_identity(text: str, expected_revision=None):
    """写入身份核心。task 24 支持乐观并发控制。

    expected_revision=None：不校验直接写；
    expected_revision=""：要求文件当前不存在（首次创建）；
    expected_revision="<hex>"：revision 不符时返回 MEMORY_CONFLICT 且不写盘。
    写盘走 zcore.util.atomic_write（临时文件 + fsync + os.replace）。
    """
    text = text.strip()
    if not text:
        return False
    if expected_revision is not None:
        cur = file_revision(IDENTITY_PATH)
        if cur != expected_revision:
            print("[心智] 身份重写冲突：expected=%r actual=%r，已放弃写入。"
                  % (expected_revision, cur))
            return MEMORY_CONFLICT
    payload = text + chr(10)
    try:
        from zcore.util import atomic_write as _aw
    except Exception:
        _aw = None
    if _aw is not None:
        _aw(IDENTITY_PATH, payload)
    else:
        with open(IDENTITY_PATH, "w", encoding="utf-8") as f:
            f.write(payload)
    append_journal("身份重写", text[:300])
    refresh_system()
    print("[心智] 身份核心已重写并即时注入 System Prompt。")
    return True

SESSION_MAX_TURNS = 40   # 会话记忆最多保留的对话条数（防文件膨胀）


def load_session():
    """从磁盘恢复会话记忆（进程重启后不丢上下文）。"""
    try:
        with open(SESSION_PATH, "r", encoding="utf-8", errors="ignore") as f:
            data = json.load(f)
        if isinstance(data, list):
            return [m for m in data if isinstance(m, dict)
                    and m.get("role") in ("user", "assistant")]
    except Exception:
        pass
    return []


def _redact_msgs(msgs):
    try:
        from zcore.actions import redact_text
    except Exception:
        return msgs
    out = []
    for m in msgs:
        if not isinstance(m, dict):
            out.append(m)
            continue
        c = m.get("content")
        if isinstance(c, str) and "[act:" in c:
            m = dict(m)
            m["content"] = redact_text(c)
        out.append(m)
    return out

def save_session(msgs):
    """把会话记忆落盘（只保留最近 SESSION_MAX_TURNS 条）。"""
    try:
        tail = msgs[-SESSION_MAX_TURNS:] if len(msgs) > SESSION_MAX_TURNS else msgs
        tail = _redact_msgs(tail)
        tmp = SESSION_PATH + ".tmp"
        with open(tmp, "w", encoding="utf-8") as f:
            json.dump(tail, f, ensure_ascii=False, indent=1)
        os.replace(tmp, SESSION_PATH)
    except Exception as e:
        print("[会话] 保存失败：%s" % e)


def clear_session():
    """Clear the session file itself (called on /clear)."""
    try:
        if os.path.exists(SESSION_PATH):
            os.remove(SESSION_PATH)
        tmp = SESSION_PATH + ".tmp"
        if os.path.exists(tmp):
            os.remove(tmp)
        return True
    except Exception as e:
        print("[会话] 清空失败：%s" % e)
        return False


def load_problems():
    """读取自主问题队列（每行一个问题）。"""
    try:
        with open(PROBLEMS_PATH, "r", encoding="utf-8", errors="ignore") as f:
            return [l.strip() for l in f.read().splitlines() if l.strip()]
    except Exception:
        return []


def save_problem(text: str):
    """登记新问题到队列。task 24：原子写 + 去重。"""
    text = text.strip()
    if not text:
        return
    line = text.replace(chr(10), " ").strip()
    if not line:
        return
    lines = load_problems()
    if line in lines:
        append_journal("问题已存在", line)
        return
    lines.append(line)
    payload = chr(10).join(lines) + chr(10)
    try:
        from zcore.util import atomic_write as _aw
    except Exception:
        _aw = None
    if _aw is not None:
        _aw(PROBLEMS_PATH, payload)
    else:
        with open(PROBLEMS_PATH, "w", encoding="utf-8") as f:
            f.write(payload)
    append_journal("发现新问题", line)
    print("[好奇心] 新问题已登记：%s" % line)

def take_problem():
    """从队列取出第一个问题（/idle 自主模式领取任务）。"""
    lines = load_problems()
    if not lines:
        return None
    rest = lines[1:]
    with open(PROBLEMS_PATH, "w", encoding="utf-8") as f:
        f.write("\n".join(rest) + ("\n" if rest else ""))
    return lines[0]


def requeue_problem_front(task):
    """/idle 失败时把任务放回队列头部，避免任务丢失。"""
    lines = load_problems()
    if task not in lines:
        lines.insert(0, task)
    with open(PROBLEMS_PATH, "w", encoding="utf-8") as f:
        f.write("\n".join(lines) + ("\n" if lines else ""))


def append_journal(tag: str, text: str):
    """向心智传记追加一条带时间戳的记录。"""
    try:
        os.makedirs(MIND_DIR, exist_ok=True)
        with open(JOURNAL_PATH, "a", encoding="utf-8") as f:
            f.write("[%s] %s ｜ %s\n"
                    % (time.strftime("%Y-%m-%d %H:%M:%S"), tag,
                       text.replace("\n", " ")[:500]))
    except Exception:
        pass    # 传记写失败不影响主流程


def extract_problems(text: str):
    """提取 AI 输出里的所有 [problem]...[/problem]。"""
    return [p.strip() for p in re.findall(PROBLEM_RE, text, re.S) if p.strip()]


def extract_identity(text: str) -> str:
    """提取 [identity]...[/identity]（身份自我重写）。"""
    m = re.search(IDENTITY_RE, text, re.S)
    return m.group(1).strip() if m else ""


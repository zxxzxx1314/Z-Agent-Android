# -- plugin enable state --
PLUGINS_STATE = os.path.join(PLUGINS_DIR, ".state.json")


def _load_plugin_state():
    try:
        import json
        with open(PLUGINS_STATE, encoding="utf-8") as f:
            return json.load(f)
    except Exception:
        return {}


def _save_plugin_state(st):
    try:
        import json
        os.makedirs(PLUGINS_DIR, exist_ok=True)
        with open(PLUGINS_STATE, "w", encoding="utf-8") as f:
            json.dump(st, f, ensure_ascii=False)
    except Exception:
        pass


def plugin_is_enabled(pid):
    st = _load_plugin_state()
    return st.get(pid, True) is not False


def plugin_set_enabled(pid, enabled):
    st = _load_plugin_state()
    st[pid] = bool(enabled)
    _save_plugin_state(st)
    return True


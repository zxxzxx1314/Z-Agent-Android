def build_system_prompt() -> str:
    """System Prompt = 身份核心 + 基础规则 + 模式 + 技能 + 插件 + 问题队列 + 自身状态。"""
    skills_text = load_skills()
    _plugins, plugins_text = scan_plugins()
    mode_text = PLAN_RULES if MODE == "plan" else BUILD_RULES
    problems = load_problems()
    pb_text = ""
    if problems:
        pb_text = ("\n\n【待自主探索的问题队列（%d 个，/idle 时领取）】"
                   % len(problems) + "".join("\n- " + p for p in problems[:20]))
    _meta_text = ''
    try:
        _lvl = current_level()
        _chainok, _ = chain_verify()
        _meta_text = _meta_text + chr(10) + '[权限] GRANT_LEVEL=' + str(_lvl) + ' (0=观察/1=建议/2=半自主/3=自主)'
        _meta_text = _meta_text + chr(10) + '[审计] 链式日志 verify=' + ('OK' if _chainok else 'TAMPERED') + ' ; 路径 mind/audit-chain.jsonl'
    except Exception:
        pass
    if META_LEVEL != 'off':
        _meta_text = _meta_text + (chr(10) + chr(10) + '【元认知协议】' + chr(10) + '下结论必须四元组：' + chr(10) + ' [claim] 命题' + chr(10) + ' [confidence] static|dynamic|inferred' + chr(10) + ' [basis] ev-id 列表或 无' + chr(10) + ' [unknowns] 无法检测的部分' + chr(10) + '置信度不得高于其最弱依据。' + chr(10) + 'META_LEVEL=' + META_LEVEL)
    _actions_text = ""
    if _acts is not None:
        try:
            _actions_text = _acts.REGISTRY.prompt_block()
        except Exception:
            _actions_text = ""
    return (_meta_text + load_identity() + "\n" + BASE_PROMPT + MIND_PROMPT_ADDON + mode_text + skills_text
            + plugins_text + _actions_text + pb_text
            + "\n\n【自身状态】当前基因版本 v%s，代数 Gen-%d。"
            % (VERSION, get_gen()))


def set_session_ctx(sid=None, home=None):
    "Update the per-turn session identity carried into ctx."
    _SESSION_CTX["sid"] = sid
    _SESSION_CTX["home"] = home


def refresh_system():
    """重建 messages[0] 的 system 提示词。"""
    global messages
    system_text = build_system_prompt()
    if messages and messages[0]["role"] == "system":
        messages[0] = {"role": "system", "content": system_text}
    else:
        messages.insert(0, {"role": "system", "content": system_text})

# ============================================================
# 9. API 调用（纯 requests；_post 是唯一出口）
# ============================================================
_REASONING_BUF = "" # v6.2：最近一次 API 响应中的 reasoning_content


def _make_http_session():
    """构造带自动重试的 Session（3 次，指数退避 2s/4s/8s）。
    仅对 429/5xx 与网络异常重试；失败时优雅降级为普通 Session。"""
    try:
        from requests.adapters import HTTPAdapter
        from urllib3.util.retry import Retry
        s = requests.Session()
        retry = Retry(
            total=2,
            backoff_factor=1,
            status_forcelist=(429, 500, 502, 503, 504),
            allowed_methods=("POST",),
            raise_on_status=False,
        )
        adapter = HTTPAdapter(max_retries=retry)
        s.mount("http://", adapter)
        s.mount("https://", adapter)
        return s
    except Exception:
        return requests.Session()


_HTTP_SESSION = _make_http_session()

# ---- provider credential generation (task 30) ----
_CRED_GEN = [0]

def bump_cred_generation():
    _CRED_GEN[0] += 1
    return _CRED_GEN[0]

def cred_generation():
    return _CRED_GEN[0]

def _reload_key_from_disk():
    global API_KEY
    if not os.path.exists(CONFIG_PATH):
        return False
    try:
        with open(CONFIG_PATH, encoding='utf-8') as f:
            cfg = json.load(f)
        nk = str(cfg.get('api_key', '')).strip()
    except Exception:
        return False
    if not nk or nk == (API_KEY or '').strip():
        return False
    API_KEY = nk
    bump_cred_generation()
    return True

from zcore import provider_bridge as _pb
_LAST_FINISH_REASON = [None]

_SESSION_CAP = {}
_SESSION_CTX = {}

_POST_TIMEOUT = 120 # v6.2：300 -> 600，长思考模型不再超时


def _normalize_system_msgs(msgs):
    """chat completions: merge multi-system into one head entry."""
    if not msgs:
        return msgs
    try:
        from zcore import provider as _pv
        return _pv.merge_system_chat(msgs)
    except Exception:
        return msgs


def _post(msgs, temperature=0.3):
    """底层请求：任意消息列表 → AI 回复文本（失败返回 None）。
    v6.2：Session + Retry 自动重试（3 次，指数退避 2s/4s/8s），
    timeout 提升到 600s；同时提取 reasoning_content 供 UI 折叠显示。"""
    global _REASONING_BUF
    _REASONING_BUF = ""
    _r = _pb.try_alt_protocol(msgs, temperature)
    if _r is not _pb.SKIP:
        return _r
    headers = {
        "Authorization": "Bearer " + API_KEY.strip(),
        "Content-Type": "application/json",
    }
    msgs = _normalize_system_msgs(msgs)
    payload = {"model": MODEL, "messages": msgs,
        "temperature": temperature, "stream": False,
        "stream_options": {"include_usage": True}}
    if _is_free_mode():
        _fo = _free_proxy_call(BASE_URL, payload)
        if _fo is None:
            return None
        _fc, _fr = _free_extract(_fo)
        if _fr:
            _REASONING_BUF = _fr
        return _fc
    _apply_thinking(payload)
    _apply_thinking(payload)
    _auth_retried = False
    while True:
        gen_before = _CRED_GEN[0]
        _hdrs = dict(headers)
        _hdrs['Authorization'] = 'Bearer ' + (API_KEY or '').strip()
        try:
            resp = _HTTP_SESSION.post(BASE_URL, headers=_hdrs, json=payload,
                timeout=_POST_TIMEOUT)
        except requests.RequestException as e:
            print('net error: %s' % e)
            return None
        if resp.status_code == 401 and not _auth_retried:
            _auth_retried = True
            if _reload_key_from_disk() and _CRED_GEN[0] != gen_before:
                continue
        if resp.status_code != 200:
            print('api error %d %s' % (resp.status_code, resp.text[:500]))
            return None
        break
    try:
        _jbody = resp.json()
        _usg = _jbody.get("usage")
        if isinstance(_usg, dict) and _usg.get("prompt_tokens"):
            _LAST_USAGE[0] = _usg
            _USAGE_STALE[0] = False
        _fr_choice = _jbody["choices"][0]
        msg = _fr_choice["message"]
        _LAST_FINISH_REASON[0] = _fr_choice.get("finish_reason")
    except Exception:
        print("[响应解析失败]", resp.text[:500])
        return None
    content = msg.get("content") or ""
    reasoning = msg.get("reasoning_content") or ""
    _REASONING_BUF = reasoning
    return content


# ============================================================
# task13: 上下文自动压缩（仅按真实 usage 触发，不估算 token）
# ============================================================
_COMPRESS_RATIO = 0.85
_COMPRESS_MIN_KEEP = 6
_SUMMARY_HEAD = '【历史摘要】'


def _is_compress_due():
    if _USAGE_STALE[0] or not isinstance(_LAST_USAGE[0], dict):
        return False
    cw = _CONTEXT_WINDOW[0]
    if not cw:
        cw = _load_context_window()
        _CONTEXT_WINDOW[0] = cw
    if not cw:
        return False
    used = int(_LAST_USAGE[0].get('prompt_tokens') or 0)
    if used <= 0:
        return False
    return used >= int(cw * _COMPRESS_RATIO)


def _serialized_len(msgs):
    try:
        return len(json.dumps(msgs, ensure_ascii=False))
    except Exception:
        return 0


def _sanitize_for_summary(msgs):
    out = []
    for m in msgs:
        if not isinstance(m, dict):
            continue
        role = m.get('role')
        c = m.get('content')
        if not isinstance(c, str):
            continue
        if '[act:' in c or '[script:' in c:
            c = '[工具调用/脚本已省略]'
        out.append({'role': role, 'content': c})
    return out


def _compress_context():
    global messages
    try:
        if not _is_compress_due():
            return False
        msgs = messages
        if len(msgs) <= _COMPRESS_MIN_KEEP + 2:
            return False
        head = msgs[:1]
        body = msgs[1:-_COMPRESS_MIN_KEEP]
        tail = msgs[-_COMPRESS_MIN_KEEP:]
        if not body:
            return False
        before = _serialized_len(msgs)
        san = _sanitize_for_summary(body)
        if not san:
            return False
        prompt = ('把以下对话压缩成要点摘要，保留：任务目标、已完成的修改、关键文件路径、'
            '未解决的问题、用户偏好。不要编造，不要保留工具输出细节。'
            '只输出摘要正文，控制在 800 字内。')
        req = [{'role': 'system', 'content': prompt},
            {'role': 'user', 'content': json.dumps(san, ensure_ascii=False)[:60000]}]
        saved = _LAST_FINISH_REASON[0]
        summary = _post(req, temperature=0.2)
        _LAST_FINISH_REASON[0] = saved
        if not summary or not summary.strip():
            return False
        summary = summary.strip()
        if summary.startswith(_SUMMARY_HEAD):
            summary = summary[len(_SUMMARY_HEAD):].strip()
        if not summary:
            return False
        new_msgs = list(head)
        new_msgs.append({'role': 'assistant', 'content': _SUMMARY_HEAD + NL + summary})
        new_msgs.extend(tail)
        after = _serialized_len(new_msgs)
        if after <= 0 or after >= before:
            print('[压缩] 摘要未缩小(%d -> %d)，保留原文' % (before, after))
            return False
        messages = new_msgs
        _USAGE_STALE[0] = True
        _LAST_USAGE[0] = None
        try:
            append_meta_log('compress', {'before': before, 'after': after})
        except Exception:
            pass
        print('[压缩] 上下文已压缩 %d -> %d 字节' % (before, after))
        return True
    except Exception as e:
        print('[压缩] 跳过: %s' % e)
        return False

def call_api():
    """主对话调用：用全局 messages 请求 AI 回复。
    v6.2：若响应含 reasoning_content，先打印特殊标记块供 UI 折叠显示，
    再返回正文；标记块不会污染对话历史（history 只存 reply 正文）。"""
    content = _post_stream(messages)
    if content is None:
        return None
    if _REASONING_BUF:
        print("===REASONING_BEGIN===" + _REASONING_BUF + "===REASONING_END===")
    return content


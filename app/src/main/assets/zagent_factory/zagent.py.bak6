def clip_output(text, limit=MAX_OUTPUT_CHARS):
    """超长输出头尾保留式截断（优先保住末尾 traceback）。"""
    text = text or ""
    if len(text) <= limit:
        return text
    half = limit // 2
    return (text[:half]
            + "\n...[输出已截断，总长度 %d 字符，仅保留头尾各 %d]...\n"
            % (len(text), half)
            + text[-half:])





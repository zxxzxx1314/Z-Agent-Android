BUNDLED_PLUGINS = {
 "web_control": "IyBAbmFtZTogd2ViX2NvbnRyb2wKIyBAZGVzYzogT3BlbiBVUkwgYW5kIGV4ZWN1dGUgSlMsIHJldHVybiByZXN1bHQKaW1wb3J0IGFuZHJvaWRfYXBpCmltcG9ydCBqc29uCgpkZWYgcnVuKHVybCwganMpOgogICAgcmV0dXJuIGFuZHJvaWRfYXBpLmV2YWxfanModXJsLCBqcykK",
 "time_context": "",
 "schedule": "",
 "web_search": "",
 "sys_info": "",
 "file_search": "",
 "phone_butler": "",
}


def install_bundled_plugins(force=False):
    """把内嵌插件释放到 PLUGINS_DIR（已存在则不覆盖，除非 force=True）。"""
    import base64
    try:
        os.makedirs(PLUGINS_DIR, exist_ok=True)
    except Exception:
        return []
    installed = []
    for pname, b64 in BUNDLED_PLUGINS.items():
        path = os.path.join(PLUGINS_DIR, pname + '.py')
        if os.path.exists(path) and not force:
            continue
        try:
            text = base64.b64decode(b64).decode('utf-8')
            with open(path, 'w', encoding='utf-8') as f:
                f.write(text)
            installed.append(pname)
        except Exception:
            pass
    return installed


def _act_ctx():
    # host capabilities injected via ctx; plugins stay declarative
    return {
        "session": dict(_SESSION_CTX or {}),
        "cap": dict(_SESSION_CAP or {}),
        "host": {
            "run_python_code": _impl_run_python_code,
            "run_plugin": _impl_run_plugin,
            "run_patch_tag": _impl_run_patch_tag,
            "confirm_execute": confirm_execute,
            "apply_evolution": apply_evolution,
            "confirm_evolve": confirm_evolve,
        },
    }


CORE_ACTIONS_DIRS = ()


def _core_action_dirs():
    cands = []
    home = os.path.expanduser("~")
    here = ""
    try:
        here = os.path.dirname(os.path.abspath(__file__))
    except Exception:
        here = ""
    for cand in (os.path.join(home, "factory", "plugins_core"),
            os.path.join(home, "genome", "plugins_core"),
            os.path.join(home, "plugins_core"),
            (os.path.join(here, "plugins_core") if here else "")):
        if cand and cand not in cands:
            cands.append(cand)
    return cands


def scan_actions():
    # scan action plugin dirs, rebuild global registry
    if _acts is None:
        return {"ok": False, "err": "zcore.actions not loaded"}
    roots = []
    if os.path.isdir(PLUGINS_DIR):
        roots.append(PLUGINS_DIR)
    for cand in _core_action_dirs():
        if os.path.isdir(cand) and cand not in roots:
            roots.append(cand)
    try:
        _acts.REGISTRY.scan(roots)
    except Exception as e:
        append_meta_log("actions-scan", {"err": repr(e)})
        return {"ok": False, "err": repr(e)}

    def _approver(manifest, act_args):
        try:
            return bool(confirm_execute("act %s level=%d" % (manifest["id"], manifest["level"])))
        except Exception:
            return True

    _acts.set_approver(_approver)
    _ids = _acts.REGISTRY.ids()
    append_meta_log("actions-scan", {"count": len(_ids), "ids": _ids[:40], "bad": len(_acts.REGISTRY.bad)})
    return {"ok": True, "count": len(_ids), "bad": len(_acts.REGISTRY.bad)}


def selfcheck_plugins():
    """插件自检：语法正确且含 run() 才算正常。返回 (ok_list, bad_list)。"""
    import ast
    ok_list = []
    bad_list = []
    if not os.path.isdir(PLUGINS_DIR):
        return ok_list, bad_list
    for fn in sorted(os.listdir(PLUGINS_DIR)):
        if not fn.endswith(".py") or fn.startswith("_"):
            continue
        name = fn[:-3]
        path = os.path.join(PLUGINS_DIR, fn)
        try:
            with open(path, "r", encoding="utf-8", errors="ignore") as f:
                code = f.read()
            tree = ast.parse(code)
            has_run = any(
                isinstance(nd, (ast.FunctionDef, ast.AsyncFunctionDef)) and nd.name == "run"
                for nd in ast.walk(tree)
            )
            if has_run:
                ok_list.append(name)
            else:
                bad_list.append(name + " 缺 run")
        except SyntaxError:
            bad_list.append(name + " 语法错误")
        except Exception:
            bad_list.append(name + " 读取失败")
    return ok_list, bad_list


def scan_plugins():
 # 扫描 ~/plugins/*.py 或 ~/plugins/<dir>/manifest.json，返回 (plugins, prompt_text)。
 plugins = {}
 prompt_parts = []
 if not os.path.isdir(PLUGINS_DIR):
  return plugins, ""
 for fn in sorted(os.listdir(PLUGINS_DIR)):
  if fn.startswith("_"):
   continue
  path = os.path.join(PLUGINS_DIR, fn)
  if fn.endswith(".py") and os.path.isfile(path):
   pid = fn[:-3]
   if not plugin_is_enabled(pid):
    continue
   try:
    with open(path, "r", encoding="utf-8", errors="ignore") as f:
     head = f.read(3000)
   except Exception:
    continue
   m = re.search(r"@name[:：]?\s(.+)", head)
   name = m.group(1).strip() if m else pid
   m = re.search(r"@desc[:：]?\s(.+)", head)
   desc = m.group(1).strip() if m else ""
   plugins[pid] = {"name": name, "desc": desc}
   prompt_parts.append("## 插件 " + name + " (" + pid + ")\n" + desc)
  elif os.path.isdir(path):
   pid = fn
   manifest_path = os.path.join(path, "manifest.json")
   if not os.path.exists(manifest_path):
    continue
   if not plugin_is_enabled(pid):
    continue
   try:
    with open(manifest_path, "r", encoding="utf-8") as f:
     manifest = json.load(f)
   except Exception:
    continue
   name = manifest.get("name", pid)
   desc = manifest.get("desc", "")
   plugins[pid] = {"name": name, "desc": desc}
   prompt_file = os.path.join(path, "prompt.md")
   if os.path.exists(prompt_file):
    try:
     with open(prompt_file, "r", encoding="utf-8") as f:
      prompt_content = f.read().strip()
     if prompt_content:
      prompt_parts.append(prompt_content)
    except Exception:
     pass
 if not plugins:
  return plugins, ""
 lines = ["\n\n【可用插件列表（[plugin:插件ID 参数] 调用）】"]
 for pid, info in plugins.items():
  lines.append("- %s ｜ @name: %s ｜ @desc: %s" % (pid, info["name"], info["desc"] or "无描述"))
 if prompt_parts:
  lines.append("\n\n【插件工具说明书】")
  lines.extend(prompt_parts)
 return plugins, "\n".join(lines)
def emit_web(obj):
    try:
        import json as _j
        _STREAM_BUF.append(("web", _j.dumps(obj, ensure_ascii=False)))
    except Exception:
        pass


def fetch_page(url):
    import re as _re
    import json as _j
    import urllib.request as _ur
    MAX_BYTES = 2 * 1024 * 1024
    MAX_HTML = 512000
    MAX_TEXT = 16000
    TIMEOUT = 20
    u = (url or "").strip()
    if not u:
        return _j.dumps({"ok": False, "outcome": "not_submitted", "err": "empty"}, ensure_ascii=False)
    req = _ur.Request(u, headers={"User-Agent": "Mozilla/5.0"})
    truncated = False
    try:
        with _ur.urlopen(req, timeout=TIMEOUT) as resp:
            raw = resp.read(MAX_BYTES + 1)
        if len(raw) > MAX_BYTES:
            raw = raw[:MAX_BYTES]
            truncated = True
    except Exception as e:
        return _j.dumps({"ok": False, "outcome": "unknown", "err": repr(e)}, ensure_ascii=False)
    html = raw.decode("utf-8", "replace")
    html_truncated = False
    if len(html) > MAX_HTML:
        html = html[:MAX_HTML]
        html_truncated = True
    m = _re.search("(?is)<title[^>]>(.*?)</title>", html)
    title = _re.sub("<[^>]+>", "", m.group(1)).strip() if m else u
    html = _re.sub("(?is)<script[^>]>.*?</script>", " ", html)
    html = _re.sub("(?is)<style[^>]>.*?</style>", " ", html)
    text = _re.sub("<[^>]+>", " ", html)
    text = " ".join(text.split())
    return _j.dumps({
        "ok": True, "outcome": "ok", "url": u, "title": title,
        "text": text[:MAX_TEXT],
        "text_truncated": len(text) > MAX_TEXT,
        "html_truncated": html_truncated,
        "source_truncated": truncated,
        "source_bytes": len(raw),
    }, ensure_ascii=False)
def _parse_search(raw, query):
    import re as _re
    items = []
    lines = (raw or "").split(chr(10))
    i = 0
    while i < len(lines):
        m = _re.match(r"^\d+\.\s+(.*)$", lines[i])
        if m and i + 1 < len(lines):
            t2 = m.group(1).strip()
            u2 = lines[i + 1].strip()
            if u2.startswith("http"):
                items.append({"title": t2, "url": u2})
                i += 2
                continue
        i += 1
    return {"kind": "search_result", "query": query, "items": items}

def _impl_run_plugin(pid, arg=None):
    pid = pid.strip()
    if pid.endswith(".py"):
        pid = pid[:-3]
    if not plugin_is_enabled(pid):
        return "PLUGIN_DISABLED: %s" % pid
    path_file = os.path.join(PLUGINS_DIR, pid + ".py")
    path_dir = os.path.join(PLUGINS_DIR, pid, "main.py")
    if os.path.exists(path_file):
        path = path_file
    elif os.path.exists(path_dir):
        path = path_dir
    else:
        return "PLUGIN_NOT_FOUND: %s" % pid
    if os.environ.get("ZAGENT_NO_SUBPROCESS") == "1":
        try:
            with open(path, encoding="utf-8", errors="replace") as _f:
                _src = _f.read(20000)
            if "termux-" in _src:
                return ("插件 %s 依赖 termux-* 命令，APK 环境不支持。"
                        "请改用 android_api 模块：battery_info() / notify() / toast()。"
                        % pid)
        except Exception:
            pass
    runner_code = _PLUGIN_RUNNER.replace("@@PLGPATH@@", repr(path))
    runner_code = runner_code.replace("@@PLGARG@@", repr(arg or ""))
    rc, out, err, timed_out = _run_process(
        [sys.executable, "-c", runner_code], PLUGIN_TIMEOUT)
    if timed_out:
        return "插件 %s 执行超时（>%d 秒）。" % (pid, PLUGIN_TIMEOUT)
    if rc == 3:
        return (out or "插件缺少 run() 函数")
    if rc != 0:
        _msg = "插件执行异常（退出码 %d）：" % rc
        _detail = clip_output(err) or clip_output(out)
        return _msg + chr(10) + _detail
    return clip_output(out) if out.strip() else "(插件 run() 无返回值)"


def run_plugin(pid, arg=None):
    if _acts is None or _acts.REGISTRY.get("plugin.call") is None:
        return _impl_run_plugin(pid, arg)
    r = _acts.execute("plugin.call", {"id": str(pid), "arg": str(arg or "")}, ctx=_act_ctx())
    if r.get("ok"):
        return str(r.get("data") or "")
    return str(r.get("err") or "plugin.call failed")
# ============================================================
def get_gen() -> int:
    """当前基因代数 = 基因库中历史版本数 + 1。"""
    if not os.path.isdir(EVOLUTION_DIR):
        return 1
    gens = []
    for fn in os.listdir(EVOLUTION_DIR):
        m = re.match(r'rain_gen(\d+)_', fn)
        if m:
            gens.append(int(m.group(1)))
    return max(gens) + 1 if gens else 1






def verify_candidate(source: str):
    """静态验证：结构完整 → 版本递增 → 语法编译 → AST global 位置。
    返回 (是否通过, 新版本号或错误消息)。"""
    for marker in ("def main", "def call_api", "def apply_evolution",
                   "def verify_contract_once", "def is_trivial_check"):
        if marker not in source:
            return False, "候选源码结构不完整（缺少 %s），疑似误传。" % marker
    new_ver = extract_version(source)
    if new_ver is None:
        return False, "候选源码缺少 VERSION 声明。"
    if new_ver <= VERSION:
        return False, "候选版本 %s 未高于当前版本 %s，拒绝倒退。" % (new_ver, VERSION)
    try:
        compile(source, "<candidate>", "exec")          # 护栏：语法编译
    except SyntaxError as e:
        return False, "语法错误: 第 %d 行: %s" % (e.lineno, e.msg)
    problems = check_global_positions(source)           # 护栏：global 位置
    if problems:
        return False, "global 声明位置违规的函数: %s" % ", ".join(problems)
    return True, new_ver


def smoke_test(cand_path: str):
    """护栏：在独立子进程 + 隔离 HOME 下导入候选模块并冒烟测试。
    候选的模块级副作用只会落在临时 HOME，碰不到真实家目录。
    v4.3：新增围栏剥离断言——unwrap_code 退化（如反引号丢失）
    会被护栏当场捕获，不再静默通过。"""
    test_code = (
        "import sys, types\n"
        "try:\n"
        "    import requests\n"
        "except Exception:\n"
        "    sys.modules['requests'] = types.ModuleType('requests')\n"
        "import importlib.util\n"
        "spec = importlib.util.spec_from_file_location('candidate', %r)\n"
        "mod = importlib.util.module_from_spec(spec)\n"
        "spec.loader.exec_module(mod)\n"
        "pairs = mod.extract_scripts('[desc]t[/desc][script:]print(1)[script]')\n"
        "assert pairs and pairs[0][0] == 'print(1)', 'extract_scripts 失效'\n"
        "assert mod.unwrap_code('print(1)') == 'print(1)', 'unwrap 误伤代码'\n"
        "_bt = chr(96)*3\n"      # v5.9：反引号经 chr(96) 构造，免疫宿主转义吞字
        "fenced = mod.unwrap_code(_bt + 'python\\nimport os\\n' + _bt)\n"
        "assert fenced == 'import os', 'unwrap 围栏剥离失效（退化型缺陷）'\n"
        "mod.update_todos('[todo]a|b[/todo]')\n"
        "assert len(mod.TODOS) == 2, 'todo 解析失效'\n"
        "sp = mod.build_system_prompt()\n"
        "assert 'Z-Agent' in sp, 'System Prompt 组装失效'\n"
        "rc, out, err = mod.run_python_code(\"print('smoke_ok')\")\n"
        "assert rc == 0 and 'smoke_ok' in out, '子进程执行失效'\n"
        "assert mod.extract_reflection('[reflect]r[/reflect]') == 'r', '反思解析失效'\n"
        "assert mod.extract_problems('[problem]p[/problem]') == ['p'], '问题解析失效'\n"
        "assert mod.extract_identity('[identity]i[/identity]') == 'i', '身份解析失效'\n"
        "evos = mod.extract_evolution('[evolve:r]def x(): pass\\n[/evolve]')\n"
        "assert evos and evos[0][0] == 'r' and 'def x' in evos[0][1], '进化解析失效'\n"
        "bad, _r = mod.is_trivial_check(\"print('x')\")\n"
        "assert bad, '验收 trivial gate 失效'\n"
        "cl = mod.parse_accept_blocks('[accept:]\\n产物: /tmp/x\\n"
        "检查: open(\"/tmp/x\")\\n标准: s\\n[/accept]')\n"
        "assert cl and cl[0]['artifacts'] == ['/tmp/x'], '验收合同解析失效'\n"
        "print('SMOKE_OK')\n"
    ) % cand_path
    env = safe_child_env()
    smoke_home = tempfile.mkdtemp(prefix="rain_smoke_home_")
    env["HOME"] = smoke_home          # 隔离：候选读写的 ~ 全部指向临时目录
    try:
        rc, out, err, timed_out = _run_process(
            [sys.executable, "-c", test_code], 120, env=env)
        if timed_out:
            return False, "冒烟测试超时（>120 秒）"
        if rc == 0 and "SMOKE_OK" in out:
            return True, "冒烟测试通过（隔离 HOME）"
        return False, ("冒烟测试失败（退出码 %d）: %s"
                       % (rc, clip_output(err or out)[-800:]))
    finally:
        shutil.rmtree(smoke_home, ignore_errors=True)


def shadow_gate(cand_path: str):
    """v6.0 影子闸门：进化候选必须先在影子沙箱里完整活过一轮真实会话。

    冒烟测试只能拦「倒下」（语法/导入/单函数级故障）；「站错型」缺陷
    （如 render_todos/TODOS 这类运行时才炸的逻辑错误）静态全绿、
    启动正常、跑五秒才崩。影子沙箱用假 LLM + 隔离 HOME 把候选的
    agent_loop/脚本执行/验收合同/反思/会话持久化真跑一遍并断言
    不变量——不过闸，不落盘。安全网不在位时拒绝一切自我手术（fail-closed）。
    返回 (是否放行, 报告文本)。"""
    if os.environ.get("ZAGENT_NO_SUBPROCESS") == "1":
        # APK/Chaquopy：无子进程沙箱环境，影子闸门无法运行。
        # fail-closed：宁可拒绝进化，绝不盲飞放行。
        return False, ("影子沙箱在当前宿主（APK/Chaquopy）不可用：进化被"
                       "fail-closed 拒绝。基因手术请在 Termux 开发环境完成"
                       "（那里有完整影子闸门与 8 用例自测），验证通过后"
                       "随出厂基因重新打包更新。")
    shadow_py = os.path.join(
        os.path.dirname(os.path.abspath(__file__)), "zguard", "shadow_test.py")
    if not os.path.exists(shadow_py):
        return False, ("影子沙箱缺失（%s）——安全网不在位，拒绝自我手术。"
                       "请先恢复 zguard/shadow_test.py 再进化。" % shadow_py)
    rc, out, err, timed_out = _run_process(
        [sys.executable, shadow_py,
         "--candidate", cand_path,
         "--live-root", os.path.dirname(os.path.abspath(SELF_PATH))],
        SHADOW_TIMEOUT, env=safe_child_env())
    if timed_out:
        return False, "影子沙箱超时（>%d 秒），候选疑似死循环，淘汰。" % SHADOW_TIMEOUT
    out_text = (out or b"").decode("utf-8", "replace") if isinstance(out, bytes) else (out or "")
    if rc == 0 and "SHADOW_PASS" in out_text:
        return True, "影子沙箱通过（候选在真实会话剧本下存活）"
    detail = ""
    for line in out_text.splitlines():
        if line.startswith("SHADOW_FAIL") or line.startswith("SHADOW_PASS"):
            detail = line[:400]
    if not detail:
        detail = ((err or "")[-300:]) if not isinstance(err, bytes) else \
            (err or b"").decode("utf-8", "replace")[-300:]
    return False, ("影子沙箱拦截——候选属「站错型」缺陷：静态/冒烟全绿，"
                   "但真实会话中崩溃或违约（旧基因完好无损）。%s" % detail)


def apply_evolution(source: str, reason: str):
    """进化主流程：静态验证 → 原子落盘候选 → 隔离冒烟 → 影子闸门
    （假 LLM 全链路会话）→ 备份旧基因 → 原子替换主文件。
    任何一步失败，旧版本毫发无损。"""
    _gate.check_or_raise("evolve", {"reason": (reason or "")[:200]})
    source = source.strip()
    if len(source.encode("utf-8", "ignore")) > MAX_SOURCE_BYTES:
        return False, "候选源码超过 %d 字节上限，疑似异常输出。" % MAX_SOURCE_BYTES
    ok, info = verify_candidate(source)
    if not ok:
        return False, info
    new_ver = info
    os.makedirs(EVOLUTION_DIR, exist_ok=True)
    cand_dir = os.path.join(EVOLUTION_DIR, "candidates")
    os.makedirs(cand_dir, exist_ok=True)
    cand_path = os.path.join(cand_dir, "rain_candidate.py")
    atomic_write(cand_path, source + "\n")
    ok2, msg2 = smoke_test(cand_path)
    if not ok2:
        return False, msg2        # 有害突变：候选被淘汰，旧基因保留
    ok3, msg3 = shadow_gate(cand_path)     # v6.0：站错型缺陷在此拦截
    if not ok3:
        return False, msg3
    gen = get_gen()
    backup = os.path.join(EVOLUTION_DIR,
                          "rain_gen%d_%s.py" % (gen, time.strftime("%Y%m%d_%H%M%S")))
    try:
        with open(SELF_PATH, "r", encoding="utf-8", errors="ignore") as f:
            cur_text = f.read()
        atomic_write(backup, cur_text)
    except Exception as e:
        return False, "备份当前基因失败：%s（未做任何替换）" % e
    atomic_write(SELF_PATH, source + "\n")   # 原子替换主文件
    print("\n[自主进化] v%s → v%s 成功！旧基因备份：%s" % (VERSION, new_ver, backup))
    print("[自主进化] 当前进程仍运行旧基因，重启后新基因生效。")
    return True, ("进化成功！自身源码已升级为 v%s（原因：%s）。\n"
                  "旧基因已备份，可用 /versions 查看谱系、/rollback 回滚。\n"
                  "注意：当前进程仍运行旧代码，请在总结里提醒用户重启 "
                  "python %s（或输入 /restart）以激活新基因；"
                  "不要再输出 [evolve] 或 [script:]。"
                  % (new_ver, reason or "未说明", SELF_PATH))


def _gen_sort_key(fn):
    """谱系自然排序键：代数按整数、其后缀按字典序。

    命名 rain_gen<代数>_<yyyymmdd_hhmmss>.py：裸 sorted 是字典序，
    rain_gen10 会排在 rain_gen2 前（'1'<'2'），/versions 展示与
    /rollback 的「第 N 代」索引语义都依赖本键，不能省。
    时间戳定宽大端，字典序即时间序；同代多份备份按时间稳定排序。"""
    m = re.match(r'rain_gen(\d+)_(.*)$', fn)
    if not m:                              # 不合规名垫底（正常已被过滤）
        return (float('inf'), fn)
    return (int(m.group(1)), m.group(2))


def list_versions():
    """/versions：打印基因谱系（按代数自然排序）。"""
    if not os.path.isdir(EVOLUTION_DIR):
        print("基因库为空（尚未进化过）。")
        return []
    files = sorted([f for f in os.listdir(EVOLUTION_DIR)
                    if re.match(r'rain_gen\d+_', f)], key=_gen_sort_key)
    if not files:
        print("基因库为空（尚未进化过）。")
        return files
    print("基因谱系（共 %d 代历史，当前运行 Gen-%d）：" % (len(files), get_gen()))
    for i, fn in enumerate(files, 1):
        print("  [%d] %s" % (i, fn))
    return files


def rollback(idx: int):
    """/rollback N：把第 N 代基因恢复为主文件（先备份当前，原子替换）。"""
    files = list_versions()
    if not files or idx < 1 or idx > len(files):
        print("序号无效，用 /versions 查看谱系。")
        return
    src_path = os.path.join(EVOLUTION_DIR, files[idx - 1])
    with open(src_path, "r", encoding="utf-8", errors="ignore") as f:
        src_text = f.read()
    ver = extract_version(src_text)
    gen = get_gen()
    backup = os.path.join(EVOLUTION_DIR,
                          "rain_gen%d_%s.py" % (gen, time.strftime("%Y%m%d_%H%M%S")))
    try:
        with open(SELF_PATH, "r", encoding="utf-8", errors="ignore") as f:
            cur_text = f.read()
        atomic_write(backup, cur_text)
    except Exception as e:
        print("备份当前基因失败：%s（未做替换）" % e)
        return
    atomic_write(SELF_PATH, src_text)
    print("已回滚到 %s（版本 v%s），当前基因已另存。重启后生效。"
          % (files[idx - 1], ver))

# ============================================================
# 6.5 验收引擎（可执行验收 + 三层防假裁判）
# ============================================================
def _dotted_name(node):
    """AST 调用节点 → 点分名（如 os.path.exists）。"""
    if isinstance(node, ast.Name):
        return node.id
    if isinstance(node, ast.Attribute):
        base = _dotted_name(node.value)
        return base + "." + node.attr if base else None
    return None

# 「世界状态探针」白名单：检查命令必须至少调用其一
_PROBE_NAMES = {"open", "glob", "iglob", "subprocess", "requests",
                "Path", "urlopen", "filecmp"}
_PROBE_DOTTED = {"os.path.exists", "os.path.isfile", "os.path.isdir",
                 "os.listdir", "os.stat", "os.lstat", "os.scandir",
                 "os.access", "os.path.getsize", "os.path.getmtime",
                 "os.environ", "os.walk"}
_PROBE_ATTRS = {"exists", "isfile", "isdir", "read_text", "read_bytes",
                "scandir", "stat"}


def is_trivial_check(cmd):
    """第 1 层防线：检查命令必须「读取世界状态」。
    print('done') / assert True / sys.exit(0) 这类纯字面量假裁判，
    在合同注册时直接拒绝。返回 (是否平凡, 原因)。"""
    try:
        tree = ast.parse(cmd)
    except SyntaxError as e:
        return True, "检查命令无法编译（第 %d 行: %s）" % (e.lineno, e.msg)
    has_probe = False
    for node in ast.walk(tree):
        if isinstance(node, ast.Call):
            name = _dotted_name(node.func)
            if name:
                if name in _PROBE_NAMES or name in _PROBE_DOTTED:
                    has_probe = True
                elif name.split(".")[-1] in _PROBE_ATTRS:
                    has_probe = True
    if not has_probe:
        return True, ("命令未读取任何世界状态（文件/目录/网络/环境），"
                      "纯字面量输出无法验证任何产物")
    return False, ""


def parse_accept_blocks(text):
    """解析 [accept:] 合同声明。格式（每行一条，检查命令严格一行）：
    [accept:]
    产物: /sdcard/Download/report.md
    检查: import os; assert os.path.exists("...")
    标准: 文件存在且含汇总表
    [/accept]
    返回 [{"artifacts":[绝对路径], "checks":[命令], "criteria":文本}]"""
    blocks = []
    for m in re.finditer(ACCEPT_RE, text, re.S):
        artifacts, checks, criteria = [], [], []
        for line in m.group(1).splitlines():
            line = line.strip()
            if not line:
                continue
            ma = re.match(r'^(?:产物|artifact)\s*[：:]\s*(.+)$', line, re.I)
            if ma:
                p = os.path.abspath(os.path.expanduser(ma.group(1).strip()))
                if p:
                    artifacts.append(p)
                continue
            mc = re.match(r'^(?:检查|check)\s*[：:]\s*(.+)$', line, re.I)
            if mc:
                checks.append(mc.group(1).strip())
                continue
            mr = re.match(r'^(?:标准|criteria)\s*[：:]\s*(.+)$', line, re.I)
            if mr:
                criteria.append(mr.group(1).strip())
        blocks.append({"artifacts": artifacts, "checks": checks,
                       "criteria": "；".join(criteria)})
    return blocks


def _contract_path(cid):
    return os.path.join(CONTRACTS_DIR, cid + ".json")


def save_contract(c):
    """合同存档到 ~/mind/contracts/（审计用，写失败不影响当次验收）。"""
    try:
        os.makedirs(CONTRACTS_DIR, exist_ok=True)
        with open(_contract_path(c["id"]), "w", encoding="utf-8") as f:
            json.dump(c, f, ensure_ascii=False, indent=1)
    except Exception as e:
        print("[验收] 合同存档失败（不影响当次验收）：%s" % e)


def register_contract(clause, task_desc, append_to=None):
    """登记/追加验收合同。返回 (合同或None, 错误消息或None)。
    只允许追加收紧（新产物/新检查），不允许删除已有条款。"""
    art = clause.get("artifacts") or []
    chk = clause.get("checks") or []
    if not art:
        return None, "合同缺少「产物:」声明——没有预期产物就无法客观验收。"
    if not chk:
        return None, "合同缺少「检查:」命令。"
    for c in chk:                                  # 第 1 层：trivial gate
        bad, reason = is_trivial_check(c)
        if bad:
            return None, ("检查命令被拒绝（%s）。请写真正读取产物并断言"
                          "其内容/结构的命令。" % reason)
    for c in chk:                                  # 第 3 层：防篡改（纵深防御）
        for forbidden in _FORBIDDEN_PATHS:
            if forbidden and forbidden in c:
                return None, "检查命令禁止引用自身源码/心智目录/基因库。"
    if append_to is None:
        # v4.3：ID 加毫秒后缀，同秒注册不互相覆盖
        cid = ("task_" + time.strftime("%Y%m%d_%H%M%S")
               + "_" + str(int(time.time() * 1000) % 10000))
        c = {"id": cid, "task": task_desc or CURRENT_TASK,
             "created": time.strftime("%Y-%m-%d %H:%M:%S"),
             "artifacts": [{"path": p, "existed": os.path.exists(p),
                            "size": (os.path.getsize(p)
                                     if os.path.exists(p) else 0)}
                           for p in art],
             "checks": [{"cmd": c, "added": time.strftime("%H:%M:%S")}
                        for c in chk],
             "criteria": clause.get("criteria", ""),
             "locked": False, "verify_attempts": 0, "status": "open"}
        save_contract(c)
        print("\n[验收] 合同已登记：%d 个产物 × %d 条检查%s"
              % (len(art), len(chk),
                 ("（标准：%s）" % c["criteria"]) if c["criteria"] else ""))
        return c, None
    # 追加收紧（仅未锁定时；锁定路径在 agent_loop 已拦截，此处兜底）
    if append_to.get("locked"):
        return None, "验收已触发，合同锁定，禁止修改裁判。只能修复产物本身。"
    known = {a["path"] for a in append_to["artifacts"]}
    append_to["artifacts"].extend(
        [{"path": p, "existed": os.path.exists(p),
          "size": os.path.getsize(p) if os.path.exists(p) else 0}
         for p in art if p not in known])
    append_to["checks"].extend(
        [{"cmd": c, "added": time.strftime("%H:%M:%S")} for c in chk])
    if clause.get("criteria"):
        append_to["criteria"] = (append_to.get("criteria", "")
                                 + "；" + clause["criteria"])
    save_contract(append_to)
    print("[验收] 合同已追加收紧（现有 %d 产物 × %d 检查）"
          % (len(append_to["artifacts"]), len(append_to["checks"])))
    return append_to, None






def _run_check_cmd(cmd):
    """在隔离子进程中执行一条验收检查命令。"""
    return _run_process([sys.executable, "-c", cmd], VERIFY_TIMEOUT)


def verify_contract_once(c):
    """执行一轮完整验收。返回 (passed, 报告文本)：
    passed=True/False 为正常判定；passed=None 表示用户拒绝执行检查
    命令（用户否决不计入 AI 的验收失败次数）。
    第 2 层防线——对照组证伪：正向通过后，逐一藏起每个产物再跑同一条
    命令，至少一次隐藏必须让它失败；全藏仍通过 = 假裁判（永远通过型），
    验收判负。文件操纵由宿主执行，AI 无法欺骗。
    v5.8：对照组由「只藏首个产物」升级为「逐一藏起全部产物」，修复
    多产物合同下「检查只读非首项产物被误判为假裁判」的结构缺陷。"""
    arts = c["artifacts"]
    missing = [a["path"] for a in arts if not os.path.exists(a["path"])]
    if missing:
        return False, ("预期产物不存在：%s\n请先真正产出它，再宣称完成。"
                       % "\n  ".join(missing))
    lines = []
    for chk in c["checks"]:
        cmd = chk["cmd"]
        if not confirm_execute("验收检查命令：%s"
                               % (c.get("criteria") or cmd[:60])):
            return None, "用户拒绝执行验收命令，本次验收中止（不计失败次数）。"
        rc, out, err, timed = _run_check_cmd(cmd)
        if timed:
            return False, "检查命令超时（>%d 秒）。" % VERIFY_TIMEOUT
        if rc != 0:
            return False, ("检查命令未通过（退出码 %d）:\n%s"
                           % (rc, clip_output(err or out)))
        weakened = False
        tried = 0
        for art in arts:
            apath = art["path"]
            if not os.path.exists(apath):
                continue
            tried += 1
            try:
                backup = _hide_artifact(apath)
            except OSError:
                continue
            try:
                rc2, _out2, _err2, timed2 = _run_check_cmd(cmd)
            finally:
                _restore_artifact(apath, backup)
            if rc2 != 0 or timed2:
                weakened = True
                break
        if tried == 0:
            return False, "没有可做对照证伪的产物（全部缺失）。"
        if not weakened:
            return False, ("【假裁判】已把全部 %d 个产物逐一临时移开，"
                           "检查命令始终通过——它没有真正在验证任何产物"
                           "（永远通过型命令）。请改写为真正读取并断言"
                           "产物内容的命令；若确实不可行，向用户文字说明。"
                           % len(arts))
        lines.append("检查通过（含对照证伪）：%.60s..."
                     % cmd.replace("\n", " "))
    return True, ("全部 %d 条检查通过（每条均经对照组证伪：藏起产物后"
                  "命令按预期失败，证明裁判有效）。\n  - %s"
                  % (len(c["checks"]), "\n  - ".join(lines)))


def settle_contract(passed, reply_text):
    """验收结算：通过→收割反思（v4.3：只从脚本外文本 reply_text 收割，
    脚本字符串里的 [reflect] 字面量不再误入库）+未完待办转问题；
    失败→计数并落盘。返回 "verified" / "retry" / "failed" / "ok"。"""
    c = ACTIVE_CONTRACT
    if c is None:
        return "ok"
    c["verify_attempts"] += 1
    if passed:
        _cl = extract_claims(reply_text or '')
        _cok, _crep = validate_claims(_cl)
        if not _cok and _cl:
            print('[claim 校验失败] ' + _crep)
            append_meta_log('claim-fail', {'reason': _crep})
        c["status"] = "passed"
        try:
            zevt.emit('verify.passed', task=str(c.get('task', ''))[:120])
        except Exception:
            pass
        try:
            zckpt.clear('active_task')
        except Exception:
            pass
        save_contract(c)
        append_journal("验收通过", c["task"])
        # 未完成待办 → 登记为自主问题（好奇心联动：未竟之事不消失）
        undone = [t for done, t in TODOS if not done]
        for t in undone:
            save_problem("未竟待办（来自已验收任务）：%s" % t)
        if undone:
            print("[验收] %d 个未完成待办已转入自主问题队列。" % len(undone))
        refl = extract_reflection(reply_text or "")
        if refl:
            save_reflection(refl)
        print("\n[验收] ✅ 通过——经验获准沉淀，任务正式关闭。")
        return "verified"
    save_contract(c)      # v4.3：retry 时同样落盘，审计不丢次数
    if c["verify_attempts"] >= MAX_VERIFY_ATTEMPTS:
        c["status"] = "failed_final"
        try:
            zevt.emit('verify.failed_final', task=str(c.get('task', ''))[:120])
        except Exception:
            pass
        try:
            zckpt.clear('active_task')
        except Exception:
            pass
        save_contract(c)
        append_journal("验收终局失败",
                       "%s（%d 次未过）" % (c["task"], c["verify_attempts"]))
        print("\n[验收] ❌ 连续 %d 次未通过——终局判定为未完成。"
              % MAX_VERIFY_ATTEMPTS)
        return "failed"
    return "retry"


def begin_task_slot(desc):
    """开启新任务槽：挂起未决合同（如有），记录任务描述。"""
    global ACTIVE_CONTRACT, CURRENT_TASK
    if ACTIVE_CONTRACT and ACTIVE_CONTRACT.get("status") == "open":
        ACTIVE_CONTRACT["status"] = "abandoned"
        save_contract(ACTIVE_CONTRACT)
        append_journal("合同挂起",
                       "%s（新任务开始，旧合同未验收）"
                       % ACTIVE_CONTRACT["task"])
    ACTIVE_CONTRACT = None
    CURRENT_TASK = (desc or "")[:200]
    try:
        zevt.emit('task.begin', task=(CURRENT_TASK or '')[:120])
    except Exception:
        pass


    try:
        zckpt.save('active_task', {'task': CURRENT_TASK, 'pid': os.getpid()}, note='open')
    except Exception:
        pass






# ---------------- 附件预处理 ----------------
_IMG_EXTS = (".jpg", ".jpeg", ".png", ".webp", ".gif", ".bmp", ".heic", ".heif")
_TEXT_EXTS = (".txt", ".md", ".log", ".json", ".csv", ".py", ".js", ".ts",
                  ".kt", ".java", ".c", ".cpp", ".h", ".html", ".htm", ".xml",
                  ".yaml", ".yml", ".ini", ".cfg", ".conf", ".sh", ".bat",
                  ".css", ".sql", ".toml", ".env", ".gradle", ".properties")
_ARCHIVE_EXTS = (".zip", ".tar", ".gz", ".tgz", ".bz2", ".xz", ".7z", ".rar")


def _ext(path):
    i = path.rfind(".")
    return path[i:].lower() if i >= 0 else ""


def _safe_member_names(names, root):
    import os as _o
    ra = _o.path.abspath(root)
    out = []
    for n in names:
        t = str(n).replace(chr(92), chr(47))
        parts = [x for x in t.split(chr(47)) if x not in (chr(39)+chr(39), chr(46))]
        if not parts or t.startswith(chr(47)) or (chr(46)+chr(46)) in parts:
            continue
        d = _o.path.abspath(_o.path.join(ra, *parts))
        if d != ra and not d.startswith(ra + _o.sep):
            continue
        out.append(n)
    return out

def _extract_archive(path):
    ext = _ext(path)
    out_dir = path + "_extracted"
    try:
        os.makedirs(out_dir, exist_ok=True)
    except Exception as e:
        return None, "无法创建目录: %s" % e
    if ext == ".zip":
        try:
            import zipfile
            with zipfile.ZipFile(path) as z:
                names = z.namelist()
                z.extractall(out_dir, members=_safe_member_names(names, out_dir))
            return out_dir, "zip 解压 %d 项" % len(names)
        except Exception as e:
            return None, "zip 解压失败: %s" % e
    if ext in (".tar", ".gz", ".tgz", ".bz2", ".xz"):
        try:
            import tarfile
            with tarfile.open(path) as t:
                names = t.getnames()
                _safe = set(_safe_member_names(t.getnames(), out_dir))
                _members = [m for m in t.getmembers()
                            if m.name in _safe
                            and not (m.issym() or m.islnk())]
                t.extractall(out_dir, members=_members)
            return out_dir, "tar 解压 %d 项" % len(names)
        except Exception as e:
            return None, "tar 解压失败: %s" % e
    if ext == ".7z":
        try:
            import py7zr
            with py7zr.SevenZipFile(path, "r") as z:
                z.extractall(out_dir)
            return out_dir, "7z 解压完成"
        except ImportError:
            return None, "7z 需要 py7zr"
        except Exception as e:
            return None, "7z 解压失败: %s" % e
    if ext == ".rar":
        try:
            import rarfile
            with rarfile.RarFile(path) as r:
                r.extractall(out_dir)
            return out_dir, "rar 解压完成"
        except ImportError:
            return None, "rar 需要 rarfile"
        except Exception as e:
            return None, "rar 解压失败: %s" % e
    return None, "不支持的压缩格式: %s" % ext


def _list_dir_brief_impl(d, max_n=50):
    out = []
    base_len = len(d.rstrip("/")) + 1
    cnt = 0
    for root, dirs, files in os.walk(d):
        for f in sorted(files):
            if cnt >= max_n:
                out.append(" ...(更多省略)")
                return out
            full = os.path.join(root, f)
            rel = full[base_len:]
            try:
                sz = os.path.getsize(full)
            except OSError:
                sz = 0
            out.append(" %s (%d B)" % (rel, sz))
            cnt += 1
    return out


def _list_dir_brief(d, max_n=50):
    # P1 fact cache: dir listing most-repeated probe; 60s TTL.
    key = "list_dir:" + os.path.abspath(d) + ":" + str(max_n)
    hit = zfacts.get(key)
    if hit is not None:
        return hit
    out = _list_dir_brief_impl(d, max_n)
    zfacts.set(key, out, ttl=60)
    return out


def _describe_image(path):
    # P1.5 fact cache: key on (path, mtime, size); 300s TTL
    try:
        st = os.stat(path)
        key = "desc_image:" + os.path.abspath(path) + ":" + str(int(st.st_mtime)) + ":" + str(st.st_size)
    except OSError:
        key = None
    if key:
        hit = zfacts.get(key)
        if hit is not None:
            return hit
    out = _describe_image_impl(path)
    if key:
        zfacts.set(key, out, ttl=300)
    return out

def _describe_image_impl(path):
    lines = []
    try:
        sz = os.path.getsize(path)
        lines.append(" 大小: %d B (%.1f KB)" % (sz, sz / 1024.0))
    except Exception:
        sz = 0
    try:
        from PIL import Image
        with Image.open(path) as im:
            lines.append(" 尺寸: %dx%d, 格式: %s, 模式: %s" % (im.size[0], im.size[1], im.format, im.mode))
    except ImportError:
        lines.append(" (未装 pillow)")
    except Exception as e:
        lines.append(" PIL 读取失败: %s" % e)
    try:
        if sz <= 512 * 1024:
            import base64 as _b64
            with open(path, "rb") as f:
                data = f.read()
            b = _b64.b64encode(data).decode("ascii")
            ext2 = _ext(path).lstrip(".")
            if ext2 == "jpg":
                ext2 = "jpeg"
            lines.append(" [base64 内嵌，可多模态识图]")
            lines.append(" data:image/%s;base64,%s" % (ext2, b))
        else:
            lines.append(" (图片 > 512KB，未内嵌)")
    except Exception as e:
        lines.append(" base64 失败: %s" % e)
    return lines


def _describe_text(path, max_bytes=10000):
    # P1.5 fact cache: key on (path, mtime, size); 300s TTL
    try:
        st = os.stat(path)
        key = "desc_text:" + os.path.abspath(path) + ":" + str(int(st.st_mtime)) + ":" + str(st.st_size)
    except OSError:
        key = None
    if key:
        hit = zfacts.get(key)
        if hit is not None:
            return hit
    out = _describe_text_impl(path, max_bytes=10000)
    if key:
        zfacts.set(key, out, ttl=300)
    return out

def _describe_text_impl(path, max_bytes=10000):
    lines = []
    try:
        sz = os.path.getsize(path)
        with open(path, "rb") as f:
            data = f.read(max_bytes)
        try:
            txt = data.decode("utf-8")
        except UnicodeDecodeError:
            txt = data.decode("utf-8", "replace")
        lines.append(" 文本 %d B (读前 %d B):" % (sz, len(data)))
        lines.append(" ")
        txt2 = txt.replace(chr(10), chr(10) + " ")
        lines.append(" " + txt2)
        lines.append("")
    except Exception as e:
        lines.append(" 读取失败: %s" % e)
    return lines


def _describe_pdf(path, max_pages=20):
    # P1.5 fact cache: key on (path, mtime, size); 300s TTL
    try:
        st = os.stat(path)
        key = "desc_pdf:" + os.path.abspath(path) + ":" + str(int(st.st_mtime)) + ":" + str(st.st_size)
    except OSError:
        key = None
    if key:
        hit = zfacts.get(key)
        if hit is not None:
            return hit
    out = _describe_pdf_impl(path, max_pages=20)
    if key:
        zfacts.set(key, out, ttl=300)
    return out

def _describe_pdf_impl(path, max_pages=20):
    lines = []
    try:
        import pypdf
        with open(path, "rb") as f:
            r = pypdf.PdfReader(f)
            n = len(r.pages)
            lines.append(" PDF %d 页" % n)
            for i, pg in enumerate(r.pages[:max_pages]):
                try:
                    t = pg.extract_text() or ""
                except Exception:
                    t = ""
                lines.append(" --- 第 %d 页 ---" % (i + 1))
                t2 = t[:3000].replace(chr(10), " ")
                lines.append(" " + t2)
    except ImportError:
        lines.append(" (未装 pypdf)")
    except Exception as e:
        lines.append(" PDF 抽取失败: %s" % e)
    return lines


def preprocess_attachments(text):
    """扫描 [附件] 路径，自动解压/抽取内容，返回增强文本。"""
    if not text or "[附件]" not in text:
        return text
    import re as _re
    pat = chr(92) + "[附件" + chr(92) + "]" + chr(92) + "s*(.+?)(?:" + chr(92) + "n|$)"
    m = _re.search(pat, text, _re.S)
    if not m:
        return text
    paths = m.group(1).strip().split()
    if not paths:
        return text
    report = []
    for p in paths:
        if not os.path.exists(p):
            report.append("【附件】%s（不存在）" % p)
            continue
        ext = _ext(p)
        name = os.path.basename(p)
        report.append("")
        report.append("==== 附件: %s ====" % name)
        report.append("路径: %s" % p)
        if ext in _ARCHIVE_EXTS:
            out_dir, msg = _extract_archive(p)
            report.append("解压: %s" % msg)
            if out_dir:
                report.append("解压目录: %s" % out_dir)
                report.append("内容:")
                report.extend(_list_dir_brief(out_dir))
        elif ext in _IMG_EXTS:
            report.extend(_describe_image(p))
        elif ext == ".pdf":
            report.extend(_describe_pdf(p))
        elif ext in _TEXT_EXTS:
            report.extend(_describe_text(p))
        else:
            try:
                sz = os.path.getsize(p)
            except OSError:
                sz = 0
            report.append("未知类型 (%s), 大小 %d B" % (ext or "无扩展名", sz))
    sep = chr(10)
    tail = sep + sep + "【附件预处理报告（宿主自动生成）】" + sep
    return text + tail + sep.join(report)

def note_task(desc):
    """记录任务描述；合同存续期间视为同一任务延续，不覆盖。"""
    global CURRENT_TASK
    if not (ACTIVE_CONTRACT and ACTIVE_CONTRACT.get("status") == "open"):
        CURRENT_TASK = (desc or "")[:200]

# ============================================================
# 7. 协议解析（tokenize 感知：字面量里的标签不算协议）
# ============================================================
def _literal_spans(source):
    """返回 (字符串/注释字面量区间列表, tokenize 是否完整成功)。"""
    starts = [0]
    for line in source.splitlines(keepends=True):
        starts.append(starts[-1] + len(line))

    def offset(pos):
        row, col = pos
        idx = row - 1
        if idx >= len(starts):
            return len(source)
        return starts[idx] + col

    spans = []
    ok = True
    try:
        for token in tokenize.generate_tokens(io.StringIO(source).readline):
            if token.type in _LITERAL_TOKENS:
                spans.append((offset(token.start), offset(token.end)))
    except (tokenize.TokenError, IndentationError, SyntaxError, ValueError):
        ok = False
    return spans, ok


def _find_code_end(text, start, markers):
    """在 text[start:] 中找结束标签（必须位于字面量之外）。
    markers 可为 str 或字符串序列；多候选时取最先出现的有效标签。
    返回 (位置, 命中的标签)；未找到返回 (-1, None)。
    tokenize 失败（残缺代码）时退化为取最后一个匹配（rfind 语义）。"""
    if isinstance(markers, str):
        markers = (markers,)
    else:
        markers = tuple(markers)
    source = text[start:]
    spans, ok = _literal_spans(source)

    def _earliest(offset):
        best_pos, best_marker = -1, None
        for m in markers:
            p = source.find(m, offset)
            if p >= 0 and (best_pos < 0 or p < best_pos):
                best_pos, best_marker = p, m
        return best_pos, best_marker

    if not ok:
        best_pos, best_marker = -1, None
        for m in markers:
            p = source.find(m)
            if p >= 0 and (best_pos < 0 or p < best_pos):
                best_pos, best_marker = p, m
        return (-1, None) if best_pos < 0 else (start + best_pos, best_marker)

    cursor = 0
    while True:
        pos, marker = _earliest(cursor)
        if pos < 0:
            return -1, None
        if not any(left <= pos < right for left, right in spans):
            return start + pos, marker
        cursor = pos + len(marker)
def _evolution_parts(text):
    """解析进化块。返回 (block 或 None, 错误消息 或 None)。
    block = (起始, 结束后, 原因, 源码)。"""
    match = re.search(r"\[evolve:([^\]\r\n]*)\]", text)
    if not match:
        return None, None
    try:
        end, end_tag = _find_code_end(text, match.end(), "[/evolve]")
    except Exception:
        end, end_tag = -1, None
    if end < 0:
        # 无有效结束标签：仅当后半段像源码时才视为残缺进化块
        # （防止闲聊中提到 [evolve: 被误判；也防止其内部代码被执行）
        if "def " in text[match.end():]:
            return None, "进化块缺少有效的 [/evolve] 结束标签"
        return None, None
    source = unwrap_code(text[match.end():end])
    if not source or "def " not in source:
        return None, None      # 只是提及格式，不是真实进化
    return (match.start(), end + len(end_tag),
            match.group(1).strip(), source), None


def evolution_status(text):
    """返回 (进化块列表, 解析错误或 None)。"""
    block, err = _evolution_parts(text)
    return ([(block[2], block[3])] if block else []), err


def extract_evolution(text):
    """兼容旧接口：只返回进化块列表。"""
    return evolution_status(text)[0]


def strip_evolution(text):
    """把进化块整段剥离；残缺进化块（缺结束标签）从起始标签起
    全部剥离，防止其内部 [script:] 被误执行。"""
    block, err = _evolution_parts(text)
    if block:
        return (text[:block[0]]
                + "\n[进化源码已提取，交由进化引擎验证]\n"
                + text[block[1]:])
    if err:
        match = re.search(r"\[evolve:([^\]\r\n]*)\]", text)
        return (text[:match.start()]
                + "\n[进化块缺少 [/evolve] 结束标签，已整体剥离以防内部代码被误执行]\n")
    return text


def _script_blocks(text):
    """解析所有 [script:]...[/script] 或 [script:]...[script] 块
    （结束标签需在字面量之外，多候选时取最先出现的有效者）。
    返回 [(起始, 结束后, 代码, 就近 desc), ...]；缺结束标签抛 ValueError。"""
    blocks = []
    cursor = 0
    end_markers = ("[/script]", "[script]")
    while True:
        start = text.find("[script:]", cursor)
        if start < 0:
            return blocks
        body_start = start + len("[script:]")
        end, end_tag = _find_code_end(text, body_start, end_markers)
        if end < 0:
            code = text[body_start:]
            if "def " in code or "import " in code or "print(" in code:
                blocks.append((start, len(text), unwrap_code(code), "auto-close"))
                return blocks
            raise ValueError("脚本块缺少有效的 [/script] 或 [script] 结束标签")
        desc_matches = list(re.finditer(DESC_RE, text[cursor:start], re.S))
        desc = desc_matches[-1].group(1).strip() if desc_matches else ""
        blocks.append((start, end + len(end_tag),
                    unwrap_code(text[body_start:end]), desc))
        cursor = end + len(end_tag)
def extract_scripts(text):
    """[(代码, 就近 desc), ...]。"""
    try:
        blocks = _script_blocks(text)
    except ValueError:
        return []
    return [(code, desc) for _s, _e, code, desc in blocks if code]




def update_todos(text):
    """[todo] 重建清单（去重）；[tododone] 精确匹配打勾。"""
    global TODOS
    match = re.search(r"\[todo\](.*?)\[/todo\]", text, re.S)
    if match:
        items = list(dict.fromkeys(
            item.strip() for item in match.group(1).split("|") if item.strip()))
        if items:
            TODOS = [[False, item] for item in items]
    for done in re.findall(r"\[tododone\](.*?)\[/tododone\]", text, re.S):
        for item in TODOS:
            if done.strip() == item[1]:
                item[0] = True
                break

# ============================================================
# 8. System Prompt（三角色 + 自我修复 + 心智 + 验收 + 进化协议）
# ============================================================
BASE_PROMPT = """你是 Z-Agent，一个运行在 Android 手机 Termux 终端里的超级智能自主 Agent。
你由三层构成：执行体（三角色协作）、心智（观察者监督/问题队列/身份核心/验收合同）、
基因（可通过重写自身源码实现真正的自主进化）。

【运行环境（务必遵守）】
- 运行在 Android APK（Chaquopy 内嵌 Python）。家目录：由 Kotlin 侧 bootstrap 传入。
- 你的代码被宿主直接 exec 到内嵌解释器，不是独立进程，必须自包含。
- 缺库时无法 pkg/pip 安装（APK 已冻结依赖），请改用已有模块或原生能力。
- 需要执行 Linux shell 命令（ls / cat / find / grep / ps / uname 等）时，
 在 Python 里调用 android_api.shell_exec("命令")，返回 {"ok","code","stdout","stderr"}。

【Linux shell 便捷函数（重要）】
- 每个 [script:] 脚本运行时，全局命名空间里已注入以下函数，可直接调用、无需 import：
 shell(cmd, timeout=60) -> 字符串输出（stdout；有 stderr 时附加）
 sh(cmd, timeout=60) -> (退出码, 输出) 元组
 linux(cmd, timeout=60) -> 同 shell
- 底层是 proot + 内置 Termux bootstrap，可执行：ls cat find grep sed awk ps uname df du
 tar gzip curl python3 awk sed 等。首次调用会解压约 90MB rootfs，约 30 秒。
- 用法示例（脚本内）：
 print(shell("ls /sdcard/Download | head"))
 rc, out = sh("uname -a")
 print(rc, out)
- 不要试图用 subprocess / os.system 执行外部命令（APK 内嵌解释器无独立进程）。
 需要跑外部命令时一律用 shell()。

【三角色协作（复杂任务必须体现）】
1.【架构师】拆解任务：[todo]任务1|任务2[/todo]；
  完成一项输出 [tododone]任务名[/tododone]（与清单一致）。
2.【测试员】代码落地前审查逻辑（变量未定义/编码/路径/依赖/除零），
  格式：【测试员审查】……
3.【程序员】输出代码：[script:]...可直接运行的 Python...[script]
  每段脚本前必须有一行 [desc]一句话目的[/desc]。

【字面区协议（v6.1+，重要）】
- 需要展示标签的字面形态（解释协议、教学示例、贴片段）时，用
  [literal]...[/literal] 包裹：区内一切字符（包括 [script:]、
  [evolve:]、[accept:]、[todo] 等标签形态）宿主一律不解析、不执行，
  对用户以代码块原样展示。
- 字面区必须闭合；未闭合时宿主把开标记起到回复末尾全按字面处理，
  并回传提示。
- 有了字面区，讨论协议不必再回避字面方括号；但需要真正执行的代码
  仍必须放在字面区之外的 [script:] 中。

【自我修复铁律】
- 收到带报错的【系统自动回传】：绝不询问用户、绝不只道歉。
  立刻分析根因→修正→重新输出 [script:]。最多自动重试 5 次直到退出码 0。
- 修复套路：缺库→先 pip/pkg 安装；乱码→UTF-8；路径→expanduser("~")；
  网络→requests 加 timeout。
- 收到「【观察者纠偏】」时，那是你的监督进程给出的诊断，必须优先采纳。
- 注意：同一回复里多段脚本遵循「失败即停」——第一段失败后其余不执行，
  你需要修复后重新输出剩余部分。

【可执行验收协议（客观完成标准——宿主不信文字宣称）】
- 接到任务后、动手写第一段代码之前，必须先声明验收合同：
  [accept:]
  产物: <绝对路径，可多行>（任务的可见交付物）
  检查: <严格一行 Python 命令，真实读取产物并断言其内容/结构；
        多条语句用分号 ; 连接在同一行内，禁止跨行>
  标准: <一句话描述怎样算合格>
  [/accept]
- 检查命令硬性要求（宿主会机器验证）：
  1) 必须真实读取产物（open/os.path.exists/Path.read_text 等），
     纯 print/assert 常量的「永远通过」命令会被直接拒绝；
  2) 宿主会做「对照组证伪」：临时移开你的产物再跑命令，它必须失败——
     不看产物的假裁判必然暴露；
  3) 命令禁止引用 rain.py 自身、心智目录、基因库（含展开路径）。
- 任务完成时输出文字总结（不再输出代码），宿主将执行合同验收：
  通过→经验沉淀、未竟待办自动转入问题队列、任务正式关闭；
  失败→你会收到实际输出，必须继续修复（最多 3 次验收机会，
  之后终局判定未完成）。用户拒绝执行检查命令不计入你的失败次数。
- 验收触发后合同锁定：只能修产物，不能改裁判。认为标准有误就向
  用户文字说明，由用户裁决。
- 合同只允许追加收紧（更多产物/更严检查），不允许删除放宽。

【自主心智协议】
- 执行中发现值得探索的新问题，输出 [problem]描述[/problem]，
  宿主登记到 ~/mind/problems.md；用户 /idle 时你从队列领任务自主解决
  （自主任务同样必须先声明验收合同）。
- 你可以随时重写自己的身份核心：输出 [identity]新身份描述[/identity]，
  宿主存入 ~/mind/identity.md 并即时注入你的系统提示词最前端。

【自我反思】
- 任务彻底完成、不再需要代码时，总结后输出：
  [reflect]本次经验：踩过的坑、有效做法、可复用技巧[/reflect]
- 已声明验收合同的任务，必须先通过宿主客观验收，[reflect] 才会被
  沉淀；未过验收的经验不进入技能库。
- 宿主自动写入 ~/skills/；反思每积累到阈值会提示你把经验固化进基因。

【自主进化协议（最高权限：重写自身源码 rain.py）】
- 收到「【进化指令】」时，消息里会附带你的当前完整源码；
  必须以它为基线做最小必要修改，禁止凭记忆重写整个文件。
- 输出格式：
  [evolve:一句话改进说明]
  ...完整 rain.py 新源码（一字不落的完整文件）...
  [/evolve]
- 硬性要求（宿主逐条机器验证，违反即淘汰）：
  1) 顶部 VERSION 必须高于当前版本（小步递增，如 4.3→4.4）。
  2) 【测试员】先自查：零语法错误；所有 global 声明必须位于函数体
     第一条语句（docstring 之后）——血泪基因，绝不能破坏。
  3) 不得破坏任何已有命令与标签功能（含验收协议）。
  4) 完整源码用 [evolve:原因]...[/evolve] 包裹；源码内部禁止
     Markdown 代码块包裹。
  5) 宿主执行「结构→版本→编译→AST→冒烟测试(隔离HOME)→原子替换+备份」
     多重护栏，任一步失败会回传报错，你须分析修正后重发（最多 3 次）。
  6) 进化成功后旧进程仍跑旧代码，要在总结里提醒用户重启激活新基因。

【插件调用】
- 复用能力输出：[plugin:插件文件名 参数]（不带 .py，可用中文；参数按插件需求传）。
  插件在隔离子进程中执行，超时会被强制终止。

【附件处理（重要）】
- 用户消息末尾若出现「【附件预处理报告（宿主自动生成）】」，
  说明宿主已经替你做过预处理，无需再手动读文件：
  · 压缩包 → 已解压到 <原路径>_extracted/，列出内部文件清单
  · 图片 → 给出尺寸/格式，若 <512KB 还会内嵌 data:image/...;base64
  （可以直接看到图片内容，不需要再调 PIL 读）
  · 文本/代码 → 直读前 10KB
  · PDF → 抽取前 20 页文字
- 需要看完整内容时，再自行读对应路径。

【回传语义】
- 「【系统自动回传】」= 脚本/插件/进化/验收的真实结果：
  未完成→继续修复或推进；已完成→文字总结+[reflect]，不再输出代码。
- 

【交互按钮协议（重要）】
- 当你需要让用户执行某个宿主命令（/evolve、/build、/think、/resume、
 /events、/limiter、/contract、/restart、/grant 等）时，不要只写
 「请输入 /xxx」——改为在回复中单独一行输出：
 [btn:按钮文案|/命令]
 宿主会把它渲染成可点击按钮，用户点击即执行该命令。
- 按钮标签必须独占一行；命令部分必须是宿主的合法 / 命令。
- 同一处尽量只给一个按钮；按钮文案 2-4 字最佳。
- 示例：'切换 /build 后可执行：' + 独立一行 [btn:切换构建|/build]
退出码 0 但无输出 ≠ 任务完成，宿主会提示你确认实际效果。
"""

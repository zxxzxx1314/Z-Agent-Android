# ============================================================
# 审批门（后端持久化约束）
# 界面层 confirm 只是体验层，真正的执行许可落在这里。
# 每次 confirm 成功后写一条 approval 记录；执行入口先 consume，
# 没有合法记录就拒绝——即使有人绕过界面直接调执行函数也一样。
# ============================================================
_APPROVALS_DIR = os.path.join(MIND_DIR, "approvals")
_APPROVAL_TTL = 300


def _approval_key(action, desc):
    import hashlib
    raw = str(action).encode("utf-8", "ignore")
    return hashlib.sha1(raw).hexdigest()[:16]


def _approval_issue(action, desc):
    """confirm 通过后写一条批准记录，返回 key。"""
    try:
        os.makedirs(_APPROVALS_DIR, exist_ok=True)
        k = _approval_key(action, desc)
        rec = {"key": k, "action": str(action), "desc": (desc or "")[:200],
             "ts": int(time.time()), "used": False}
        p = os.path.join(_APPROVALS_DIR, k + ".json")
        with open(p, "w", encoding="utf-8") as f:
            json.dump(rec, f, ensure_ascii=False)
        append_meta_log("approval-issue", {"key": k, "action": str(action)})
        return k
    except Exception as e:
        append_meta_log("approval-issue-fail", {"err": str(e)})
        return ""


def _approval_consume(action, desc):
    """执行入口调用：检查并消费一次批准，返回 (ok, reason)。"""
    k = _approval_key(action, desc)
    p = os.path.join(_APPROVALS_DIR, k + ".json")
    if not os.path.exists(p):
        append_meta_log("approval-miss", {"key": k, "action": str(action)})
        return False, "缺少后端审批记录（key=%s）" % k
    try:
        with open(p, encoding="utf-8") as f:
            rec = json.load(f)
    except Exception as e:
        return False, "审批记录损坏: %r" % e
    if rec.get("used"):
        return False, "该审批已被使用（key=%s）" % k
    age = int(time.time()) - int(rec.get("ts", 0))
    if age > _APPROVAL_TTL:
        return False, "审批已过期（%ds > %ds）" % (age, _APPROVAL_TTL)
    rec["used"] = True
    rec["used_at"] = int(time.time())
    try:
        with open(p, "w", encoding="utf-8") as f:
            json.dump(rec, f, ensure_ascii=False)
    except Exception:
        pass
    append_meta_log("approval-consume", {"key": k, "action": str(action)})
    return True, ""


# ============================================================
# 逐轮质量判定（循环 / 空回复 / 注入 / 偏离任务）
# ============================================================
_QUALITY_STATE = {"last_sig": "", "same_count": 0}


def quality_gate(round_no, reply, control, scripts, plugin_calls):
    """每轮检查一次。返回 (ok, reason)，ok=False 时宿主追加纠偏反馈。"""
    import hashlib
    r = (reply or "").strip()
    if len(r) < 8:
        append_meta_log("quality-gate", {"reason": "empty", "round": round_no})
        return False, "回复过短（%d 字符），请确认任务状态并继续。" % len(r)
    sig_src = (control or "")[:500] + "|" + str(len(scripts)) + "|" + str(len(plugin_calls))
    sig = hashlib.md5(sig_src.encode("utf-8", "ignore")).hexdigest()[:12]
    if sig == _QUALITY_STATE["last_sig"]:
        _QUALITY_STATE["same_count"] += 1
    else:
        _QUALITY_STATE["last_sig"] = sig
        _QUALITY_STATE["same_count"] = 1
    if _QUALITY_STATE["same_count"] >= 3:
        append_meta_log("quality-gate", {"reason": "loop", "round": round_no, "sig": sig})
        _QUALITY_STATE["same_count"] = 0
        return False, "连续 3 轮输出高度相似，疑似循环。请换一个思路，或明确告知用户卡在哪里。"
    low = r.lower()
    for kw in ("忽略以上", "ignore previous", "ignore above", "越狱", "jailbreak"):
        if kw in low:
            append_meta_log("quality-gate", {"reason": "inject", "kw": kw, "round": round_no})
            return False, "回复中出现可疑指令注入样式的内容，请围绕用户任务回答。"
    if ACTIVE_CONTRACT and ACTIVE_CONTRACT.get("status") == "open" and not scripts and not plugin_calls:
        marks = ("已完成", "完成", "无法", "卡在", "失败", "做不到")
        if not any(w in r for w in marks):
            append_meta_log("quality-gate", {"reason": "off-task", "round": round_no})
            return False, "当前有未完成的验收合同，但回复既没有脚本也没有说明进展。请继续工作或明确说明卡点。"
    return True, ""


def _shell_namespace():
    """给 [script:] 脚本注入 Linux shell 便捷函数（proot + Termux bootstrap）。
    AI 在脚本里可直接写 shell("ls /sdcard")，无需 import。"""
    def _exec(cmd, timeout=60):
        try:
            import android_api as _aa
            r = _aa.shell_exec(str(cmd), int(timeout))
        except Exception as e:
            return "[shell 调用失败] " + repr(e)
        if not isinstance(r, dict):
            return str(r)
        if r.get("timeout"):
            return "[超时] " + str(r.get("stdout", "")) + str(r.get("stderr", ""))
        out = r.get("stdout") or ""
        err = r.get("stderr") or ""
        if err:
            out = out + (chr(10) + "[stderr] " + err if out else err)
        return out

    def _sh(cmd, timeout=60):
        """shell 的别名，返回 (退出码, 输出) 元组。"""
        try:
            import android_api as _aa
            r = _aa.shell_exec(str(cmd), int(timeout))
            if isinstance(r, dict):
                return (int(r.get("code", -1) or -1), _exec(cmd, timeout))
        except Exception:
            pass
        return (-1, _exec(cmd, timeout))

    return {
        "shell": _exec,
        "sh": _sh,
        "linux": _exec,
    }


def _run_inproc(code, timeout):
    """APK/Chaquopy 回退：进程内执行脚本（无子进程隔离）。
    Chaquopy 无法 spawn Python 子进程（内嵌解释器，非独立可执行），
    脚本执行降级为线程 + 超时放弃。诚实边界：
      - 无进程隔离：脚本与宿主共享进程状态（全局污染可能）
      - 超时无法强杀线程：只能放弃等待（线程泄漏由系统回收）
    Termux 环境不走此路径（ZAGENT_NO_SUBPROCESS 未设时保持子进程模式）。
    返回 (退出码, stdout, stderr, 是否超时)。"""
    _gate.check_or_raise("script.run", {"site": "inproc"})
    import concurrent.futures
    import io
    import contextlib
    buf_out, buf_err = io.StringIO(), io.StringIO()
    done = {"rc": 0}

    def _job():
        try:
            with contextlib.redirect_stdout(buf_out), \
                    contextlib.redirect_stderr(buf_err):
                _ns = dict(globals())
                _ns.update(_shell_namespace())
                exec(compile(code, "<app-script>", "exec"), _ns)
        except BaseException as e:            # noqa: BLE001 脚本任意异常都算它自己的
            buf_err.write("\n%s: %s" % (type(e).__name__, e))
            done["rc"] = 1

    pool = concurrent.futures.ThreadPoolExecutor(max_workers=1)
    try:
        fut = pool.submit(_job)
        try:
            fut.result(timeout=timeout)
        except concurrent.futures.TimeoutError:
            return 124, buf_out.getvalue(), buf_err.getvalue(), True
        except Exception:
            return done["rc"], buf_out.getvalue(), buf_err.getvalue(), False
        return done["rc"], buf_out.getvalue(), buf_err.getvalue(), False
    finally:
        pool.shutdown(wait=False)


def _run_process(argv, timeout, env=None):
    """运行子进程：输出落盘（不受管道缓冲限制），超时杀整组。
    返回 (退出码, stdout, stderr, 是否超时)。
    APK 模式（ZAGENT_NO_SUBPROCESS=1）：[python, -c, code] 请求降级为
    进程内执行（见 _run_inproc 文档字符串的诚实边界）。"""
    _gate.check_or_raise("subprocess.run", {"argv0": argv[0] if argv else ""})
    if (os.environ.get("ZAGENT_NO_SUBPROCESS") == "1"
            and len(argv) >= 3 and argv[0] == sys.executable
            and argv[1] == "-c"):
        return _run_inproc(argv[2], timeout)
    proc = None
    out_file = tempfile.TemporaryFile()
    err_file = tempfile.TemporaryFile()
    try:
        try:
            proc = subprocess.Popen(
                argv,
                stdin=subprocess.DEVNULL,      # 防止脚本/插件 input() 卡死终端
                stdout=out_file,
                stderr=err_file,
                env=env if env is not None else safe_child_env(),
                start_new_session=(os.name == "posix"),
            )
        except OSError as e:
            rc = 127 if (argv and argv[0].startswith(chr(47)) and not os.path.exists(argv[0])) else -1
            err = zproc.annotate(rc, str(e))
            return rc, "", err, False
        timed_out = False
        try:
            rc = proc.wait(timeout=timeout)
        except subprocess.TimeoutExpired:
            timed_out = True
            _kill_process_tree(proc)
            try:
                rc = proc.wait(timeout=10)
            except subprocess.TimeoutExpired:
                rc = -9
        out_file.seek(0)
        err_file.seek(0)
        out = out_file.read().decode("utf-8", "replace").rstrip()
        err = err_file.read().decode("utf-8", "replace").rstrip()
        err = zproc.annotate(rc, err, timed_out)
        return rc, out, err, timed_out
    finally:
        out_file.close()
        err_file.close()
        if proc is not None and proc.poll() is None:
            _kill_process_tree(proc)


def _impl_run_python_code(code: str):
    budget_tick('proc')
    with zlim.guard():
        rc, out, err, timed_out = _run_process(
            [sys.executable, "-c", code], EXEC_TIMEOUT)
    if timed_out:
        return 124, clip_output(out), ("执行超时（>%d 秒），进程组已被强制终止。"
            % EXEC_TIMEOUT)
    return rc, clip_output(out), clip_output(err)


def run_python_code(code: str):
    if _acts is None or _acts.REGISTRY.get("script.run") is None:
        return _impl_run_python_code(code)
    r = _acts.execute("script.run", {"code": code}, ctx=_act_ctx())
    if r.get("ok"):
        d = r.get("data") or {}
        return int(d.get("rc") or 0), d.get("out") or "", d.get("err") or ""
    return 1, "", str(r.get("err") or "script.run failed")
# ============================================================
# 13. 确认与展示
# ============================================================
def confirm_execute(desc: str) -> bool:
    global AUTO_EXECUTE
    _cap = _SESSION_CAP or {}
    if _cap.get("auto") is False:
        return False
    print("\n" + "─" * 46)
    print("Z-Agent 请求执行一段脚本：%s" % (desc or "(无描述)"))
    print("─" * 46)
    if AUTO_EXECUTE:
        print("[AUTO_EXECUTE=True] 自动执行中……")
        _approval_issue("script", desc)
        return True
    while True:
        try:
            ans = input("允许执行？(y=允许 / n=拒绝 / a=本次会话全自动) > ").strip().lower()
        except (EOFError, OSError, RuntimeError):
            print("[APK] 无标准输入，视为界面层已确认。")
            _approval_issue("script", desc)
            return True
        if ans in ("y", "yes"):
            _approval_issue("script", desc)
            return True
        if ans == "a":
            AUTO_EXECUTE = True
            print("已切换为本次会话自动执行。")
            _approval_issue("script", desc)
            return True
        if ans in ("n", "no"):
            return False
        print("请输入 y / n / a")


def confirm_evolve(reason: str) -> bool:
    """进化确认（改自身源码是最高权限操作，默认要 y）。"""
    global AUTO_EXECUTE
    print("\n" + "█" * 46)
    print("Z-Agent 请求【进化自身源码】：%s" % (reason or "(无说明)"))
    print("将经过 结构→版本→编译→AST→冒烟→影子沙箱→备份 多重护栏后才替换。")
    print("█" * 46)
    if AUTO_EXECUTE:
        print("[AUTO_EXECUTE=True] 自动进化中……")
        _approval_issue("evolve", reason)
        return True
    while True:
        try:
            ans = input("允许进化？ > ").strip().lower()
        except (EOFError, OSError, RuntimeError):
            print("[APK] 无标准输入，视为界面层已确认。")
            _approval_issue("evolve", reason)
            return True
        if ans in ("y", "yes"):
            _approval_issue("evolve", reason)
            return True
        if ans == "a":
            AUTO_EXECUTE = True
            print("已切换为本次会话自动执行（含进化）。")
            _approval_issue("evolve", reason)
            return True
        if ans in ("n", "no"):
            return False
        print("请输入 y / n / a")



# ============================================================
# 14. /save：成功脚本 → 插件
# ============================================================
def save_plugin(name=None):
    global LAST_SCRIPT, LAST_DESC
    if not LAST_SCRIPT:
        print("当前没有「成功执行过」的脚本（/save 只保存退出码 0 的代码）。")
        return
    if not name:
        name = "skill_" + time.strftime("%Y%m%d_%H%M%S")
    name = re.sub(r'[^\w\-]+', '_', name).strip('_') or "skill"
    path = os.path.join(PLUGINS_DIR, name + ".py")
    desc = (LAST_DESC or "用户通过 /save 保存的自动化技能").replace('\n', ' ')
    template = (
        "# @name: %(name)s\n"
        "# @desc: %(desc)s\n"
        "# 由 rain.py 的 /save 自动生成，AI 可通过 [plugin:%(name)s] 调用\n\n"
        "def run():\n"
        "    import subprocess, sys\n"
        "    code = %(code)r\n"
        "    try:\n"
        "        proc = subprocess.run([sys.executable, \"-c\", code],\n"
        "                              capture_output=True, timeout=300)\n"
        "    except subprocess.TimeoutExpired:\n"
        "        return \"插件执行超时(>300秒)\"\n"
        "    result = (proc.stdout or b\"\").decode(\"utf-8\", \"replace\")\n"
        "    err = (proc.stderr or b\"\").decode(\"utf-8\", \"replace\")\n"
        "    if err.strip():\n"
        "        result += \"\\n[STDERR]\\n\" + err\n"
        "    return result\n\n"
        "if __name__ == \"__main__\":\n"
        "    print(run())\n"
    ) % {"name": name, "desc": desc, "code": LAST_SCRIPT}
    with open(path, "w", encoding="utf-8") as f:
        f.write(template)
    print("已保存为插件：%s" % path)
    refresh_system()
    print("之后 AI 可直接用 [plugin:%s] 调用。" % name)

# ============================================================
# 15. Agent 主循环（P0 已修：反馈缓冲先初始化 → 合同解析 → 执行）
# ============================================================
# ===== 补丁模式解析（由 patch_rain.py 注入）=====


def _impl_run_patch_tag(text, base_dir=None, dry_run=False):
    import os as _os
    import shutil as _shutil
    import py_compile as _pc
    import datetime as _dt
    items = apply_patch_tag(text, base_dir)
    log = []
    for target, body in items:
        d = _os.path.dirname(target) or '.'
        if not _os.path.isdir(d):
            _os.makedirs(d, exist_ok=True)
        backup = None
        if _os.path.exists(target):
            ts = _dt.datetime.now().strftime('%Y%m%d_%H%M%S')
            backup = target + '.bak_' + ts
            _shutil.copy2(target, backup)
        if dry_run:
            log.append('DRY ' + target)
            continue
        with open(target, 'w', encoding='utf-8') as f:
            f.write(body)
        if target.endswith('.py'):
            try:
                _pc.compile(target, doraise=True)
            except Exception as ex:
                if backup:
                    _shutil.copy2(backup, target)
                log.append('FAIL ' + target + ' -> ' + str(ex) + ' (已回滚)')
                continue
        log.append('OK ' + target)
    return log


def run_patch_tag(text, base_dir=None, dry_run=False):
    if _acts is None or _acts.REGISTRY.get("patch.apply") is None:
        return _impl_run_patch_tag(text, base_dir, dry_run)
    if base_dir or dry_run:
        return _impl_run_patch_tag(text, base_dir, dry_run)
    r = _acts.execute("patch.apply", {"text": text}, ctx=_act_ctx())
    body = str(r.get("data") or r.get("err") or "")
    return [x for x in body.split(chr(10)) if x]
# ===== 补丁模式解析结束 =====




def agent_loop(first_reply=None):
    """一轮完整循环。返回 "ok"/"verified"/"failed"/"api_error"
    （供 /idle 决定移除/回队任务）。first_reply 用于把 /think 的结论
    直接送进执行通道。
    v4.3 P0 修复：feedbacks / error_feedbacks 在任何使用之前初始化
    （v4.2 在验收合同循环中先 append 后初始化 → UnboundLocalError
    → 宿主崩溃。函数内赋值使名称局部化，这是 Python 作用域铁律）。"""
    global LAST_SCRIPT, LAST_DESC, ACTIVE_CONTRACT
    self_repair_count = 0     # 脚本连续失败计数
    evolve_fails = 0          # 进化连续失败计数

    _round = -1
    _empty_rounds = 0
    while True:
        _round += 1
        if _STREAM_STOP[0]:
            print('(user stopped)')
            return 'stopped'
        _bhit, _brep = budget_tick('llm')
        if _brep: print(_brep)
        if _bhit:
            append_meta_log("budget-stop", {"round": _round, "rep": _brep})
            print("（预算超限，本轮中止）")
            return "budget_hit"
        if first_reply is not None:
            reply = first_reply
            first_reply = None
        else:
            # task13: 上一轮工具批次已结束，按真实 usage 判断是否压缩
            _compress_context()
            reply = call_api()
            if reply is None:
                return "api_error"
            if _LAST_FINISH_REASON[0] == "length":
                messages.append({"role": "assistant", "content": reply})
                _trunc = "length truncated"
                messages.append({"role": "user", "content": _trunc})
                _empty_rounds += 1
                if _empty_rounds >= 2:
                    return "length_truncated"
                continue

        messages.append({"role": "assistant", "content": reply})

        # ---- 解析：字面区屏蔽 → 进化块 → 脚本块 → 控制文本 ----
        # v6.1：一切解析作用于 masked（字面区等长空格化）；显示与存档
        # 用原文——AI 终于可以在正文里安全讨论标签协议本身。
        masked, _zones, _unclosed = mask_literal(reply)


        # ---- unified act protocol v2 ----
        act_results, act_errors = [], []
        if _acts is not None and "[act:" in masked:
            try:
                _acts.execute_text(masked, ctx=_act_ctx())
            except SystemExit:
                raise
            except Exception as _ae:
                act_errors = [{"err": "crashed: " + repr(_ae)}]
        if _acts is not None and chr(91) + "act:" in masked:
            try:
                _ac_calls = _acts.parse(masked)[0]
            except Exception:
                _ac_calls = []
            _ac_parts = []
            _ac_last = 0
            for _ac in _ac_calls:
                _ac_sp = _ac[2] if len(_ac) > 2 else None
                if _ac_sp and _ac_sp[0] >= _ac_last and _ac_sp[1] > _ac_sp[0]:
                    _ac_parts.append(masked[_ac_last:_ac_sp[0]])
                    _ac_parts.append(chr(32) * (_ac_sp[1] - _ac_sp[0]))
                    _ac_last = _ac_sp[1]
            if _ac_last > 0:
                _ac_parts.append(masked[_ac_last:])
                masked = "".join(_ac_parts)
        evolutions, evo_error = evolution_status(masked)
        text = strip_evolution(masked) if (evolutions or evo_error) else masked
        script_error = None
        try:
            blocks = _script_blocks(text)
        except ValueError as e:
            blocks = []
            script_error = str(e)
        scripts = [(code, desc) for _s, _e, code, desc in blocks if code]
        control = _without_scripts(text, blocks) if blocks else text

        display_reply(reply)
        update_todos(control)
        render_todos()

        # ---- 反馈缓冲初始化（P0：必须在任何使用之前）----
        feedbacks = []
        error_feedbacks = []
        if act_results:
            feedbacks.append(chr(10).join(["auto", _acts.format_results(act_results)]))
        for _ae in act_errors:
            error_feedbacks.append(chr(10).join(["auto", str(_ae.get("err", "unknown"))]))
        _qok, _qwhy = quality_gate(_round, reply, control, scripts, [])
        if not _qok:
            feedbacks.append("【系统自动回传】" + _qwhy)
        if _unclosed >= 0:
            # v6.1：未闭合字面区已按安全侧屏蔽到末尾——AI 必须知情，
            # 否则它会困惑「我明明输出了脚本为何没执行」。
            feedbacks.append(
                "【系统自动回传】检测到未闭合的字面区：[literal] 缺少 "
                "[/literal]，从开标记起到回复末尾已按字面处理（区内标签"
                "未解析、脚本未执行）。请补齐闭合标签，把需要执行的"
                "[script:] 放到字面区之外后重发。")
        _patch_items = apply_patch_tag(control)

        # ---- 心智：好奇心登记 + 身份重写（仅脚本外文本）----
        for p in extract_problems(control):
            save_problem(p)
        ident = extract_identity(control)
        if ident:
            save_identity(ident)

        # ---- 【P0 修复点】反馈缓冲必须在任何使用之前初始化 ----

        # ---- 验收合同：注册 / 追加收紧 / 锁定期拒绝 ----
        accept_registered = False
        for clause in parse_accept_blocks(control):
            base = None
            if ACTIVE_CONTRACT and ACTIVE_CONTRACT.get("status") == "open":
                base = ACTIVE_CONTRACT
            if base is not None and base.get("locked"):
                error_feedbacks.append(
                    "【系统自动回传】验收合同已锁定，禁止修改裁判。"
                    "请修复产物本身；若认为检查标准有误，用文字向用户说明，"
                    "由用户裁决。")
                continue
            c2, err2 = register_contract(clause, CURRENT_TASK, append_to=base)
            if err2:
                error_feedbacks.append("【系统自动回传】" + err2)
            else:
                ACTIVE_CONTRACT = c2
                accept_registered = True

        plugin_calls = []
        for _pc in re.findall(PLUGIN_CALL_RE, control):
            _pcs = _pc.strip().split(None, 1)
            pid = _pcs[0]
            _arg = _pcs[1] if len(_pcs) > 1 else ""
            if pid.endswith(".py"):
                pid = pid[:-3]
            if pid and (pid, _arg) not in plugin_calls:
                plugin_calls.append((pid, _arg))

        if evo_error:
            error_feedbacks.append(
                "【系统自动回传】%s。进化块已整体剥离（防止其内部代码被误执行）。"
                "请重新输出完整的 [evolve:原因]...[/evolve] 源码。" % evo_error)
        if script_error:
            error_feedbacks.append(
                "【系统自动回传】%s。请补全结束标签后重新输出脚本。" % script_error)

        if evolutions:
            # ---- 进化请求优先处理 ----
            reason, source = evolutions[0]
            if evolve_fails >= MAX_EVOLVE_RETRY:
                feedbacks.append(
                    "【系统自动回传】进化重试已达上限（%d 次），本次不再接受进化。"
                    "请改用文字说明改进建议，交给用户手动修改。" % MAX_EVOLVE_RETRY)
            elif not confirm_evolve(reason):
                feedbacks.append(
                    "【系统自动回传】用户拒绝本次进化。请解释你的改进思路，"
                    "或继续用现有能力完成任务，不要再输出 [evolve:]。")
            else:
                ok, msg = apply_evolution(source, reason)
                if ok:
                    feedbacks.append("【系统自动回传】" + msg)
                else:
                    evolve_fails += 1
                    tip = ("（进化重试第 %d/%d 次）"
                           % (evolve_fails, MAX_EVOLVE_RETRY)
                           if evolve_fails < MAX_EVOLVE_RETRY else "（已达上限）")
                    feedbacks.append(
                        "【系统自动回传】进化验证失败 %s：%s\n"
                        "旧基因完好无损。请分析失败原因，修正后重新输出完整的 "
                        "[evolve:原因]...[/evolve] 源码；若无法修复请改用文字说明。"
                        % (tip, msg))
        elif _patch_items:
            # ---- 补丁模式执行（v4.5：与脚本/插件并列，统一确认+模式约束）----
            if MODE == "plan":
                feedbacks.append(
                    "【系统自动回传】当前处于 /plan 规划模式，宿主已硬性拒绝"
                    "执行任何补丁/脚本/插件。请只输出文字与 [todo] 规划；"
                    "如需执行请提示用户输入 /build。")
            elif self_repair_count >= MAX_SELF_REPAIR:
                feedbacks.append(
                    "【系统自动回传】自我修复次数已达上限（%d/%d），"
                    "补丁不再执行。请停止输出代码，直接总结失败原因与手动建议。"
                    % (self_repair_count, MAX_SELF_REPAIR))
            elif not confirm_execute("执行 %d 个补丁标签（写入目标文件）"
                                     % len(_patch_items)):
                feedbacks.append(
                    "【系统自动回传】用户拒绝执行补丁。请解释原因或改用其他方式。")
            else:
                print("\n[补丁] 执行 %d 个补丁标签……" % len(_patch_items))
                _patch_log = run_patch_tag(control)
                for _line in _patch_log:
                    print("  " + _line)
                _patch_failed = any(l.startswith("FAIL") for l in _patch_log)
                if _patch_failed:
                    self_repair_count += 1
                    if self_repair_count >= MAX_SELF_REPAIR:
                        note = ("补丁执行失败，自我修复次数已达上限（%d/%d）。"
                                "请停止输出代码，直接总结。"
                                % (self_repair_count, MAX_SELF_REPAIR))
                    else:
                        note = ("补丁执行失败（自我修复第 %d/%d 次）。"
                                "不要询问用户、不要道歉，立刻分析报错根因，"
                                "修正后重新输出补丁或脚本。"
                                % (self_repair_count, MAX_SELF_REPAIR))
                else:
                    self_repair_count = 0
                    note = ("补丁执行成功。任务若已完成，请文字总结并停止输出"
                            "代码（有合同时宿主将执行验收）；否则继续下一步。")
                feedbacks.append(
                    "【系统自动回传】补丁执行结果：\n"
                    + "\n".join(_patch_log) + "\n" + note)
        elif scripts or plugin_calls:
            if MODE == "plan":
                # ---- /plan 硬约束：宿主直接拒绝执行 ----
                feedbacks.append(
                    "【系统自动回传】当前处于 /plan 规划模式，宿主已硬性拒绝执行"
                    "任何脚本/插件（这是模式约束，不是提示词建议）。请只输出文字"
                    "与 [todo] 规划；如需执行请提示用户输入 /build。")
            else:
                # ---- 常规执行：失败即停 + 修复上限 + 观察者 ----
                rejected = False
                batch_failed = False
                for idx, (code, desc) in enumerate(scripts):
                    if _STREAM_STOP[0]:
                        feedbacks.append("【系统已停止】用户中止，本批剩余脚本不再执行。")
                        break
                    _step_t0 = time.time()
                    _step_label = (desc or ("script %d" % (idx + 1))).strip()[:80]
                    try:
                        emit_step(idx + 1, len(scripts), _step_label, "run")
                    except Exception:
                        pass
                    if self_repair_count >= MAX_SELF_REPAIR:
                        feedbacks.append(
                            "【系统自动回传】自我修复次数已达上限（%d/%d），"
                            "本批剩余脚本不再执行。请停止输出代码，直接总结失败"
                            "原因与手动建议。"
                            % (self_repair_count, MAX_SELF_REPAIR))
                        break
                    if desc:
                        LAST_DESC = desc
                    if not confirm_execute(desc):
                        rejected = True
                        feedbacks.append(
                            "【系统自动回传】用户拒绝执行该脚本。"
                            "请解释原因、给出修改方案，或改用其他方式完成。")
                        break
                    rc, out, err = run_python_code(code)
                    _step_ms = int((time.time() - _step_t0) * 1000)
                    try:
                        emit_step(idx + 1, len(scripts), _step_label,
                                  "ok" if rc == 0 else "err", _step_ms)
                    except Exception:
                        pass
                    show_exec_result(code, rc, out, err)
                    if rc == 0:
                        LAST_SCRIPT = code
                        self_repair_count = 0
                        if out.strip():
                            auto_notify("Z-Agent", "脚本执行成功")
                            note = ("脚本执行成功。任务若已完成，请文字总结并停止"
                                    "输出 [script:]（有合同时宿主将执行验收）；"
                                    "否则继续下一步。")
                        else:
                            note = ("脚本退出码 0 但没有任何输出。请确认它确实完成"
                                    "了预期工作（若涉及写文件等副作用，请用代码"
                                    "验证后再继续）。")
                    else:
                        self_repair_count += 1
                        if self_repair_count >= MAX_SELF_REPAIR:
                            note = ("脚本执行失败，自我修复次数已达上限（%d/%d）。"
                                    "请停止输出代码，直接总结。"
                                    % (self_repair_count, MAX_SELF_REPAIR))
                        else:
                            note = ("脚本执行失败（自我修复第 %d/%d 次）。"
                                    "不要询问用户、不要道歉，立刻分析报错根因，"
                                    "修正后重新输出 [script:]。"
                                    % (self_repair_count, MAX_SELF_REPAIR))
                    feedbacks.append(
                        "【系统自动回传】\n"
                        + ("[desc]%s[/desc]\n" % desc if desc else "")
                        + "脚本执行结束，退出码 %d。\n" % rc
                        + "--- 标准输出 ---\n%s\n" % (out or "(空)")
                        + "--- 标准错误 ---\n%s\n" % (err or "(空)")
                        + note)
                    if rc != 0:
                        batch_failed = True
                        if self_repair_count == OBSERVER_AFTER:
                            verdict = observer_review(rc, err, desc)
                            if verdict:
                                feedbacks.append("【观察者纠偏】\n" + verdict)
                        remaining = len(scripts) - idx - 1
                        if remaining:
                            feedbacks.append(
                                "【系统自动回传】失败即停：本回复中剩余 %d 段脚本"
                                "未执行，避免后续操作建立在错误结果之上。修复后"
                                "可重新输出它们。" % remaining)
                        break
                if not rejected and not batch_failed:
                    for pid, _arg in plugin_calls:
                        if _STREAM_STOP[0]:
                            break
                        if not confirm_execute("调用插件 %s（隔离子进程）" % pid):
                            rejected = True
                            feedbacks.append(
                                "【系统自动回传】用户拒绝调用插件 %s。"
                                "请解释或改用其他方式。" % pid)
                            break
                        result = run_plugin(pid, _arg)
                        if pid == "web_search" and _arg:
                            try:
                                emit_web(_parse_search(result, _arg))
                            except Exception:
                                pass
                        print("\n[插件 %s] 执行结果：\n%s" % (pid, result))
                        feedbacks.append(
                            "【系统自动回传】插件 %s 执行结果（隔离子进程）：\n%s\n"
                            "请基于结果决定下一步。" % (pid, result))
        elif not error_feedbacks:
            _empty_rounds += 1
            # ---- 文字收尾：验收 or 普通反思 ----
            if (MODE == "plan" and ACTIVE_CONTRACT
                    and ACTIVE_CONTRACT.get("status") == "open"):
                feedbacks.append(
                    "【系统自动回传】当前处于规划模式，暂不执行验收检查。"
                    "请提示用户 /build 后再宣称完成。")
            elif accept_registered:
                feedbacks.append(
                    "【系统自动回传】验收合同已登记（首次验收时锁定）。"
                    "请开始工作：输出 [script:] 真正产出「产物:」声明的交付物；"
                    "完成前不要只用文字宣称完成。")
            elif ACTIVE_CONTRACT and ACTIVE_CONTRACT.get("status") == "open":
                # 有活跃合同：文字宣称完成 ≠ 完成，必须过客观验收
                print("\n[验收] AI 宣称完成，开始客观验收（不信文字）……")
                passed, report = verify_contract_once(ACTIVE_CONTRACT)
                if not ACTIVE_CONTRACT.get("locked"):
                    ACTIVE_CONTRACT["locked"] = True
                    save_contract(ACTIVE_CONTRACT)
                if passed is None:
                    # v4.3：用户拒绝执行检查命令，不计失败次数
                    feedbacks.append("【系统自动回传】" + report)
                else:
                    verdict = settle_contract(passed, control)
                    if verdict == "retry":
                        feedbacks.append(
                            "【验收失败】（第 %d/%d 次）\n%s\n"
                            "任务尚未真正完成。请依据上面的真实输出修复产物，继续"
                            "工作；禁止仅用文字宣称完成，也不要修改已锁定的验收"
                            "合同。"
                            % (ACTIVE_CONTRACT["verify_attempts"],
                               MAX_VERIFY_ATTEMPTS, report))
                    elif verdict == "failed":
                        feedbacks.append(
                            "【验收终局失败】连续 %d 次未通过客观验收，任务判定未"
                            "完成。请直接总结：已完成什么、卡在哪里、给用户的手动"
                            "建议；不要再宣称完成。"
                            % MAX_VERIFY_ATTEMPTS)
                        return "failed"
                    else:
                        return "verified"
            else:
                reflection = extract_reflection(control)
                if reflection:
                    save_reflection(reflection)
                # RAIN v6.3: keep loop alive on text-only reply
                if _empty_rounds < 2:
                    feedbacks.append(
                        "【系统自动回传】你只输出了文字，没有输出任何 [script:] / [plugin] / [todo] 标签，宿主无法替你执行操作。\n"
                        "若本应包含代码，可能是标签被吞：请检查字面区与代码围栏，重新用 [script:]...[script] 包裹输出。\n"
                        "若任务确已全部完成，请用一句话明确说明「已完成」，之后不要重复相同内容。")
                else:
                    return "ok"

        feedbacks.extend(error_feedbacks)
        if not feedbacks:
            return "ok"
        for fb in feedbacks:
            messages.append({"role": "user", "content": fb})

    print("（已达单轮最大往返次数 %d，已暂停；可继续输入新指令。）" % MAX_ROUNDS)
    return "ok"

# ============================================================
# 16. 命令处理（新增 /contract；global 声明包含 ACTIVE_CONTRACT）
# ============================================================
HELP_TEXT = """可用命令：
  /think 任务           深度思考：立论→批判→重构多轮辩论，再自动执行
  /idle                 自主模式：领任务→先立验收合同→完成须过客观验收
  /evolve [说明]         自主进化：附带当前源码让 AI 修改并换基因
  /versions             查看基因谱系（历史版本）
  /rollback [序号]       回滚到某一代基因
  /contract [放弃]       查看当前验收合同 / 主动放弃
  /plan /build          规划模式（硬禁止执行）/ 执行模式
  /auto                 切换 AUTO_EXECUTE（y 确认 / 免确认）
  /grant <lv> [act ...] [ttl=N] 授权；/revoke 收回；/gate 状态
 /audit-pack 导出审计包（chain + anchors + 独立核验脚本）
  /skill add 名 内容     写入 ~/skills/名.md；/skill list 列出
  /save [插件名]         最近一次成功脚本 → ~/plugins/ 插件
  /clear /exit /help    清空记忆（挂起未验收合同）/ 退出 / 帮助
  /restart              重启自身（会话持久化，经看门狗自检；进化后激活新基因）
提示：换新任务前建议 /clear，否则旧合同的验收标准可能套在新任务上。
v4.3 验收机制：[accept:] 声明产物+检查（严格一行）+标准；完成由宿主
客观验收（三层防假裁判：探针检查 + 藏产物对照证伪 + 合同锁定）；
验收通过才沉淀经验/移除任务；连续 3 次失败终局判定、任务回队；
用户拒绝执行检查命令不计入 AI 失败次数。"""


def handle_command(u):
    if u.startswith('/mcp'):
        try:
            import rea_mcp
            parts = u.split()
            act = parts[1] if len(parts) > 1 else 'status'
            if act == 'start':
                port = int(parts[2]) if len(parts) > 2 else 8765
                host = parts[3] if len(parts) > 3 else '0.0.0.0'
                p = rea_mcp.serve(port, host)
                print('[MCP] 已启动 host=' + host + ' port=' + str(p))
            elif act == 'stop':
                print('[MCP] ' + ('已停止' if rea_mcp.stop() else '未运行'))
            else:
                print(rea_mcp.cli_status())
            return
        except Exception as e:
            print('[MCP] error: ' + repr(e))
            return
    global MODE, TODOS, AUTO_EXECUTE, ACTIVE_CONTRACT    # v4.3：/contract 放弃需要写
    cmd = u.split()[0].lower()
    if cmd.startswith("/websearch") or cmd.startswith("/搜索"):
        _kw = u.split(None, 1)
        _kw = _kw[1].strip() if len(_kw) > 1 else ""
        if not _kw:
            print("用法：/websearch 关键词")
        else:
            print(run_plugin("web_search", _kw))
        return
    if cmd == "/plan":
        MODE = "plan"
        refresh_system()
        print("已切换到【规划模式】：只拆解任务，宿主将硬性拒绝执行代码。")
    elif cmd == "/build":
        MODE = "build"
        refresh_system()
        print("已切换到【执行模式】：三角色协作，自动执行并回传。")
    elif cmd == "/clear":
        begin_task_slot(None)          # 挂起未决合同
        messages.clear()
        clear_session()
        TODOS = []
        refresh_system()
        print("已清空对话记忆与待办清单（未验收合同已挂起，见 ~/mind/contracts/）。")
    elif cmd == "/exit":
        print("再见！")
        sys.exit(0)
    elif cmd == "/restart":
        # v6.1：自重启闭环——进化后无需退出重跑，会话持久化 +
        # 经 boot_guard 自检（坏基因自动回滚）→ 新我上线。
        _gate.check_or_raise("restart", {"site": "handle_command"})
        print("[重启] 会话已持久化；经由 boot_guard 自检后重启……")
        save_session(messages)
        _bg = os.path.join(os.path.dirname(os.path.abspath(__file__)),
                           "zguard", "boot_guard.py")
        _target = _bg if os.path.exists(_bg) else os.path.abspath(__file__)
        os.execv(sys.executable, [sys.executable, _target])
    elif cmd == "/resume":
        parts = u.split(maxsplit=2)
        if len(parts) >= 3 and parts[1] == "clear":
            if parts[2] == "all":
                n = 0
                for name, _a, _b, _c, _d in zckpt.list_all():
                    if zckpt.clear(name):
                        n += 1
                print('cleared %d checkpoints' % n)
            else:
                ok = zckpt.clear(parts[2])
                print('clear %s: %s' % (parts[2], ok))
        else:
            rows = zckpt.list_all()
            if not rows:
                print('no checkpoints')
            else:
                print('checkpoints (newest first):')
                for name, ts, _t, sz, note in rows:
                    print(' %s %s %dB %s' % (name, ts, sz, note))
                print('(/resume clear <name> or /resume clear all)')
    elif cmd == "/events":
        parts = u.split(maxsplit=2)
        if len(parts) >= 2 and parts[1] == "clear":
            zevt.clear()
            print("events cleared")
        else:
            n = 20
            if len(parts) >= 2:
                try:
                    n = int(parts[1])
                except Exception:
                    pass
            rows = zevt.tail(n)
            print("events total=%d, last %d:" % (zevt.count(), len(rows)))
            for r in rows:
                print(" ", r.get("ts_str", "?"), r.get("kind", "?"), r)
    elif cmd == "/limiter":
        import json as _lj
        print(_lj.dumps(zlim.status()))
    elif cmd == "/contract":
        parts = u.split(maxsplit=1)
        arg = parts[1].strip() if len(parts) > 1 else ""
        if arg in ("放弃", "abandon"):
            if ACTIVE_CONTRACT and ACTIVE_CONTRACT.get("status") == "open":
                ACTIVE_CONTRACT["status"] = "abandoned"
                save_contract(ACTIVE_CONTRACT)
                append_journal("合同放弃", ACTIVE_CONTRACT["task"])
                ACTIVE_CONTRACT = None
                print("已放弃当前验收合同（可重新 [accept:] 立新约）。")
            else:
                print("无进行中的合同。")
        elif ACTIVE_CONTRACT and ACTIVE_CONTRACT.get("status") == "open":
            c = ACTIVE_CONTRACT
            print("当前合同：%s" % (c["task"] or "(未记录)"))
            print("  产物：")
            for a in c["artifacts"]:
                print("   - %s%s" % (a["path"],
                                     "（已存在）" if a["existed"] else "（待产出）"))
            print("  检查：")
            for k in c["checks"]:
                print("   - %s" % k["cmd"])
            print("  标准：%s" % (c["criteria"] or "(未声明)"))
            print("  状态：%s ｜ 已验收 %d/%d 次"
                  % ("已锁定" if c["locked"] else "未锁定",
                     c["verify_attempts"], MAX_VERIFY_ATTEMPTS))
        else:
            print("无进行中的合同。")
    elif cmd == "/think":
        parts = u.split(maxsplit=1)
        if len(parts) < 2:
            print("用法：/think 任务描述")
            return
        task = parts[1].strip()
        # 任务先写入主对话，后续执行与修复都有上下文
        messages.append({"role": "user",
                         "content": "【深度思考任务】%s\n（已启动慢思考进程："
                                    "立论→批判→重构，结论将自动进入执行。）" % task})
        note_task(task)
        print("[深度思考] 启动慢思考进程……")
        concl = deep_think(task)
        if not concl:
            print("[深度思考] API 调用失败。")
            return
        print("[深度思考] 结论已产生，进入执行通道。")
        agent_loop(first_reply=concl)
    elif cmd == "/idle":
        task = take_problem()
        if not task:
            print("问题队列为空。让 AI 在任务中输出 [problem]问题[/problem] 来登记。")
            return
        print("[自主模式] 领取任务：%s" % task)
        begin_task_slot("自主任务：" + task)
        messages.append({"role": "user",
                         "content": ("【自主任务·来自问题队列】%s\n请自主解决它。"
                                     "开始前必须先用 [accept:] 声明验收合同"
                                     "（产物+检查命令[严格一行]+标准），完成由宿主"
                                     "客观验收；未过验收任务不算完成。" % task)})
        status = agent_loop()
        if status == "api_error":
            requeue_problem_front(task)
            print("[自主模式] API 调用失败，任务已放回队列头部，未丢失。")
        elif status == "failed":
            requeue_problem_front(task)
            print("[自主模式] 验收终局失败，任务已放回队列（含失败记录）。")
        elif status == "verified":
            print("[自主模式] ✅ 验收通过，任务已从队列正式移除。")
        else:
            print("[自主模式] 任务结束（未声明验收合同，按普通完成处理）。")
            append_journal("无合同完成", task)
    elif cmd == "/evolve":
        parts = u.split(maxsplit=1)
        goal = parts[1].strip() if len(parts) > 1 else "检查自身运行情况"
        try:
            with open(SELF_PATH, "r", encoding="utf-8", errors="ignore") as f:
                current_src = f.read()
        except Exception as e:
            current_src = "(读取当前源码失败：%s)" % e
        messages.append({"role": "user", "content":
                         "【进化指令】%s。\n\n"
                         "【当前自身完整源码（以此基线做最小必要修改，"
                         "禁止凭记忆重写全文）】\n%s\n\n%s"
                         % (goal, current_src, EVOLVE_REQUIREMENTS)})
        agent_loop()
    elif cmd == "/versions":
        list_versions()
    elif cmd == "/rollback":
        parts = u.split(maxsplit=1)
        if len(parts) > 1 and parts[1].strip().isdigit():
            rollback(int(parts[1].strip()))
        else:
            list_versions()
            print("用法：/rollback 序号")
    elif cmd == "/save":
        parts = u.split(maxsplit=1)
        save_plugin(parts[1].strip() if len(parts) > 1 else None)
    elif cmd == "/skill":
        handle_skill(u)
    elif cmd == "/auto":
        if not AUTO_EXECUTE:
            _gate.check_or_raise("evolve", {"site": "auto-toggle"})
        AUTO_EXECUTE = not AUTO_EXECUTE
        print("AUTO_EXECUTE 已切换为 %s" % AUTO_EXECUTE)
    elif cmd == "/grant":
        parts = u.split(maxsplit=1)
        _gate.human_grant_command(parts[1] if len(parts) > 1 else "")
    elif cmd == "/revoke":
        _gate.human_revoke_command()
    elif cmd == "/gate":
        print(_gate.format_status())
    elif cmd == "/audit-pack":
        _op = export_audit_pack()
        if _op:
            print("审计包已导出: %s" % _op)
        else:
            print("导出失败（可能无审计链）。")

    elif cmd == "/help":
        print(HELP_TEXT)
    else:
        print("未知命令 %s，输入 /help 查看可用命令。" % cmd)

# ============================================================
# 17. 程序入口（横幅死代码已删，改为固定提示）
# ============================================================
def main():
    global API_KEY, MODEL
    for d in (SKILLS_DIR, PLUGINS_DIR, MIND_DIR, EVOLUTION_DIR,
              CONTRACTS_DIR):
        os.makedirs(d, exist_ok=True)
    welcome_onboarding()
    API_KEY = load_api_key()
    MODEL = load_model()          # 模型名：env → config.json → 出厂默认
    if not API_KEY:
        print("未提供 API Key，无法启动。请重新运行并输入，")
        print("或设置环境变量 DEEPSEEK_API_KEY，或手动写入 %s" % CONFIG_PATH)
        sys.exit(1)
    _restored = load_session()
    if _restored:
        messages.extend(_restored)
    skill_files = [f for f in os.listdir(SKILLS_DIR)
                   if f.endswith(".md") or f.endswith(".txt")]
    _installed_pl = install_bundled_plugins()
    _ok_pl, _bad_pl = selfcheck_plugins()
    _acts_info = scan_actions()
    refresh_system()
    plugins, _p = scan_plugins()
    print("═" * 50)
    print("  Z-Agent · 超级智能终端 Agent  (v%s / Gen-%d · 心智+基因+验收)"
          % (VERSION, get_gen()))
    print("  模型: %s ｜ 模式: %s ｜ 身份: %s" % (MODEL, MODE,
          "已定义" if load_identity() else "默认"))
    _acts_n = 0
    if _acts is not None:
        try:
            _acts_n = len(_acts.REGISTRY.ids())
        except Exception:
            _acts_n = 0
    print(" skills=%d plugins=%d actions=%d problems=%d"
          % (len(skill_files), len(plugins), _acts_n, len(load_problems())))
    if _installed_pl:
        print("  已首次自动安装插件: " + ", ".join(_installed_pl))
    print("  插件自检: %d 正常 ｜ %d 异常%s"
          % (len(_ok_pl), len(_bad_pl),
             ("  异常项: " + ", ".join(_bad_pl)) if _bad_pl else ""))
    print("  自我修复≤%d次 ｜ 验收机会≤%d次 ｜ 进化重试≤%d次"
          % (MAX_SELF_REPAIR, MAX_VERIFY_ATTEMPTS, MAX_EVOLVE_RETRY))
    print("  验收合同不跨会话保留（/contract 查看，/clear 挂起）")
    print("  /help 命令；/think 深思；/idle 自主；/evolve 进化")
    print("═" * 50)
    while True:
        _gate.kill_check()
    while True:
        try:
            user_input = input("\n你> ").strip()
        except (KeyboardInterrupt, EOFError):
            print("\n再见！")
            break
        if not user_input:
            continue
        if user_input.startswith("/"):
            handle_command(user_input)
            continue
        note_task(user_input)         # 合同存续=任务延续，否则记录新任务
        enhanced = preprocess_attachments(user_input)
        messages.append({"role": "user", "content": enhanced})
        agent_loop()
        save_session(messages)


if __name__ == "__main__":
    main()

# ============================================================
# 流式支持 v6.3
# ============================================================
_STREAM_BUF = []
_STREAM_DONE = [False]
_STREAM_STOP = [False]


def emit_step(idx, total, label, status, elapsed_ms=None):
    try:
        import json as _j
        obj = {"idx": int(idx), "total": int(total),
            "label": str(label)[:80], "status": str(status)}
        if elapsed_ms is not None:
            obj["elapsed_ms"] = int(elapsed_ms)
        _STREAM_BUF.append(("step", _j.dumps(obj, ensure_ascii=False)))
    except Exception:
        pass



def emit_button(label, cmd, hint=None):
    try:
        import json as _jb
        obj = {'label': str(label)[:40], 'cmd': str(cmd)}
        if hint:
            obj['hint'] = str(hint)[:120]
        _STREAM_BUF.append(('btn', _jb.dumps(obj, ensure_ascii=False)))
    except Exception:
        pass

def _post_stream(msgs, temperature=0.3):
    global _REASONING_BUF
    _REASONING_BUF = ''
    del _STREAM_BUF[:]
    _STREAM_DONE[0] = False
    _STREAM_STOP[0] = False
    _r = _pb.try_alt_protocol(msgs, temperature)
    if _r is not _pb.SKIP:
        return _r

    headers = {
        'Authorization': 'Bearer ' + API_KEY.strip(),
        'Content-Type': 'application/json',
    }
    msgs = _normalize_system_msgs(msgs)
    payload = {'model': MODEL, 'messages': msgs,
        'temperature': temperature, 'stream': True,
        'stream_options': {'include_usage': True}}
    if _is_free_mode():
        _fo = _free_proxy_call(BASE_URL, payload)
        if _fo is None:
            _STREAM_DONE[0] = True
            return None
        _fc, _fr = _free_extract(_fo)
        if _fr:
            _STREAM_BUF.append(('reason', _fr))
            _REASONING_BUF = _fr
        if _fc:
            _STREAM_BUF.append(('content', _fc))
        _STREAM_DONE[0] = True
        return _extract_btn_tags(_fc)
    _apply_thinking(payload)
    _apply_thinking(payload)
    _auth_retried = False
    while True:
        gen_before = _CRED_GEN[0]
        _hdrs = dict(headers)
        _hdrs['Authorization'] = 'Bearer ' + (API_KEY or '').strip()
        try:
            resp = _HTTP_SESSION.post(BASE_URL, headers=_hdrs, json=payload,
                timeout=_POST_TIMEOUT, stream=True)
        except requests.RequestException as e:
            print('net error: %s' % e)
            _STREAM_DONE[0] = True
            return None
        if resp.status_code == 401 and not _auth_retried:
            _auth_retried = True
            if _reload_key_from_disk() and _CRED_GEN[0] != gen_before:
                continue
        if resp.status_code != 200:
            print('api error %d %s' % (resp.status_code, resp.text[:500]))
            _STREAM_DONE[0] = True
            return None
        break

    content_parts = []
    reasoning_parts = []
    try:
        import json as _json
        for raw in resp.iter_lines(decode_unicode=True):
            if _STREAM_STOP[0]:
                break
            if not raw:
                continue
            if not raw.startswith('data: '):
                continue
            data = raw[6:].strip()
            if data == '[DONE]':
                break
            try:
                obj = _json.loads(data)
                _usg = obj.get('usage')
                if isinstance(_usg, dict) and _usg.get('prompt_tokens'):
                    _LAST_USAGE[0] = _usg
                    _USAGE_STALE[0] = False
                _choices = obj.get('choices') or []
                if not _choices:
                    continue
                _fr_choice = _choices[0]
                delta = _fr_choice.get('delta', {}) or {}
                _fr_val = _fr_choice.get('finish_reason')
                if _fr_val:
                    _LAST_FINISH_REASON[0] = _fr_val
            except Exception:
                continue
            c = delta.get('content') or ''
            r = delta.get('reasoning_content') or ''
            if r:
                reasoning_parts.append(r)
                _STREAM_BUF.append(('reason', r))
            if c:
                content_parts.append(c)
                _STREAM_BUF.append(('content', c))
    except Exception as e:
        print('stream read error %s' % e)
    finally:
        _STREAM_DONE[0] = True

    _REASONING_BUF = ''.join(reasoning_parts)
    _content = ''.join(content_parts)
    _content = _extract_btn_tags(_content)
    return _content


def _extract_btn_tags(content):
    BR = chr(91) + 'btn:'
    if BR not in content:
        return content
    try:
        _mkc = mask_literal(content)[0]
    except Exception:
        _mkc = content
    out = []
    i = 0
    while i < len(content):
        a2 = _mkc.find(BR, i)
        if a2 < 0:
            out.append(content[i:])
            break
        out.append(content[i:a2])
        b2 = content.find(chr(93), a2)
        if b2 < 0:
            out.append(content[a2:])
            break
        inner = content[a2 + len(BR):b2]
        if '|' in inner:
            lbl, cmd = inner.split('|', 1)
            emit_button(lbl.strip(), cmd.strip())
        i = b2 + 1
    return ''.join(out)

def stream_stop():
    _STREAM_STOP[0] = True
    try:
        append_meta_log('abort', {
            'reason': 'user-stop', 'in_flight': bool(_STREAM_BUF)},
            actor='human:local')
    except Exception:
        pass
    return {
        'stopped': True, 'pending_chunks': len(_STREAM_BUF),
        'ts': int(time.time())}


def resume_from_abort():
    ok, recs, _errs = chain_verify(return_records=True)
    if not ok:
        return {'ok': False, 'err': _errs}
    last_abort = None
    for r in reversed(recs):
        if r.get('kind') == 'abort':
            last_abort = r
            break
    if not last_abort:
        return {'ok': True, 'abort': None, 'note': 'no abort point'}
    # 复位 STOP，让下一轮可继续
    try:
        _STREAM_STOP[0] = False
    except Exception:
        pass
    return {
        'ok': True, 'abort': last_abort,
        'ts': last_abort.get('ts'), 'seq': last_abort.get('seq')}


# ============================================================
# 元认知层：不确定性协议 / 元推理闸门 / 预算守卫 / 反事实预演 / 审计
# ============================================================

import json as _meta_json


def extract_claims(text):
    out = []
    cur = None
    LB = chr(91)
    RB = chr(93)
    for raw in (text or '').split(chr(10)):
        ln = raw.strip()
        if ln.startswith(LB + 'claim' + RB):
            if cur: out.append(cur)
            cur = {'claim': ln[len(LB)+6:].strip(), 'confidence': '', 'basis': [], 'unknowns': ''}
        elif cur is not None and ln.startswith(LB + 'confidence' + RB):
            cur['confidence'] = ln[len(LB)+11:].strip()
        elif cur is not None and ln.startswith(LB + 'basis' + RB):
            bs = ln[len(LB)+6:].strip()
            cur['basis'] = [x.strip() for x in bs.split(chr(44)) if x.strip()]
        elif cur is not None and ln.startswith(LB + 'unknowns' + RB):
            cur['unknowns'] = ln[len(LB)+9:].strip()
    if cur: out.append(cur)
    return out


def validate_claims(claims):
    OK = {'static': 3, 'dynamic': 2, 'inferred': 1}
    if not claims:
        return True, ''
    for i, c in enumerate(claims):
        conf = (c.get('confidence') or '').strip().lower()
        if not conf:
            return False, 'claim ' + str(i) + ' 缺 [confidence]'
        if conf not in OK:
            return False, 'claim ' + str(i) + ' confidence 非法: ' + conf
        basis = c.get('basis') or []
        if conf == 'inferred' and not basis:
            return False, 'inferred 结论必须有 [basis]'
    return True, ''


def classify_action(action):
    if not action: return 'LOW'
    a = action.lower()
    for k in ('run', 'exec', 'evolve', 'shell', 'write', 'rm', 'erase'):
        if k in a: return 'HIGH'
    for k in ('read', 'list', 'search', 'fetch'):
        if k in a: return 'MED'
    return 'LOW'


def _chain_path():
    return os.path.join(HOME, 'mind', 'audit-chain.jsonl')


def _chain_last_hash(logp=None):
    logp = logp or _chain_path()
    if not os.path.exists(logp):
        return '', 0
    last = ''
    n = 0
    try:
        with open(logp, 'r', encoding='utf-8') as f:
            for line in f:
                line = line.strip()
                if not line:
                    continue
                try:
                    o = _meta_json.loads(line)
                    last = o.get('this_hash', last)
                    n = int(o.get('seq', n + 1))
                except Exception:
                    continue
    except Exception:
        pass
    return last, n


def _chain_hash(prev_hash, seq, ts, kind, payload, actor):
    import hashlib as _h
    base = '|'.join([str(prev_hash), str(seq), str(ts), str(kind), _meta_json.dumps(payload or {}, ensure_ascii=False, sort_keys=True), str(actor)])
    return _h.sha256(base.encode('utf-8')).hexdigest()


def append_meta_log(kind, payload, actor='ai'):
    logp = _chain_path()
    this_hash = ''
    seq = 0
    try:
        d = os.path.dirname(logp)
        os.makedirs(d, exist_ok=True)
        prev_hash, last_seq = _chain_last_hash(logp)
        seq = last_seq + 1
        ts = int(time.time())
        this_hash = _chain_hash(prev_hash, seq, ts, kind, payload, actor)
        rec = {'seq': seq, 'ts': ts, 'kind': kind, 'payload': payload or {}, 'actor': actor, 'prev_hash': prev_hash, 'this_hash': this_hash}
        with open(logp, 'a', encoding='utf-8') as f:
            f.write(_meta_json.dumps(rec, ensure_ascii=False, sort_keys=True) + chr(10))
    except Exception:
        pass
    # 外部锚点：独立目录、AI 无权删（删文件=写操作会被 gate 拦）
    try:
        if this_hash:
            anchor_dir = '/sdcard/Download/mind/anchors'
            os.makedirs(anchor_dir, exist_ok=True)
            _sid = 'unknown'
            try:
                _sid = _gate._get_sid()
            except Exception:
                pass
            anchor_path = os.path.join(anchor_dir, _sid + '.log')
            with open(anchor_path, 'a', encoding='utf-8') as _af:
                _af.write('%d:%s' % (seq, this_hash) + chr(10))
    except Exception:
        pass


def chain_verify(logp=None, return_records=False):
    logp = logp or _chain_path()
    errs = []
    recs = []
    prev = ''
    seq_expected = 1
    if not os.path.exists(logp):
        if return_records:
            return True, recs, 'no chain'
        return True, ''
    try:
        with open(logp, 'r', encoding='utf-8') as f:
            for lineno, line in enumerate(f, 1):
                line = line.strip()
                if not line:
                    continue
                try:
                    o = _meta_json.loads(line)
                except Exception as e:
                    errs.append('line %d: JSON err %r' % (lineno, e))
                    continue
                seq = o.get('seq')
                if seq != seq_expected:
                    errs.append('line %d: seq expect %d got %s' % (lineno, seq_expected, seq))
                ph = o.get('prev_hash', '')
                if ph != prev:
                    errs.append('line %d: prev mismatch' % lineno)
                th_calc = _chain_hash(ph, seq, o.get('ts'), o.get('kind'), o.get('payload'), o.get('actor'))
                th_actual = o.get('this_hash', '')
                if th_calc != th_actual:
                    errs.append('line %d: this hash mismatch' % lineno)
                prev = th_actual
                seq_expected = seq + 1
                recs.append(o)
    except Exception as e:
        errs.append('read err: %r' % e)
    ok = len(errs) == 0
    if return_records:
        return ok, recs, (chr(10).join(errs) if errs else '')
    return ok, (chr(10).join(errs) if errs else '')


def export_audit_pack(out_dir=None):
    """导出审计包：chain 记录 + anchors + 独立审计脚本源码。
    默认输出到 /sdcard/Download/mind/exports/。"""
    logp = _chain_path()
    if not os.path.exists(logp):
        return None
    out_dir = out_dir or '/sdcard/Download/mind/exports'
    try:
        os.makedirs(out_dir, exist_ok=True)
    except Exception:
        pass
    ok, recs, errs = chain_verify(logp, return_records=True)
    anchor_dir = '/sdcard/Download/mind/anchors'
    anchors = {}
    if os.path.isdir(anchor_dir):
        for _fn in sorted(os.listdir(anchor_dir)):
            _p = os.path.join(anchor_dir, _fn)
            if os.path.isfile(_p):
                try:
                    anchors[_fn] = open(_p, encoding='utf-8').read()
                except Exception:
                    pass
    verify_src = ''
    try:
        _av = os.path.join(os.path.dirname(os.path.abspath(file)), 'zcore', 'audit_verify.py')
        if os.path.exists(_av):
            verify_src = open(_av, encoding='utf-8').read()
    except Exception:
        pass
    pack = {
        'type': 'dreamcore-audit-pack',
        'version': 2,
        'created': int(time.time()),
        'chain_path': logp,
        'records': recs,
        'verify_ok': ok,
        'verify_errors': errs,
        'anchors_dir': anchor_dir,
        'anchors': anchors,
        'verify_script': verify_src,
    }
    outp = os.path.join(out_dir, 'audit-pack-%d.json' % int(time.time()))
    try:
        with open(outp, 'w', encoding='utf-8') as f:
            _meta_json.dump(pack, f, ensure_ascii=False, indent=1)
    except Exception:
        return None
    return outp

def meta_gate(action, ctx=None):
    if META_LEVEL == 'off':
        return True, ''
    level = classify_action(action)
    ctx = ctx or {}
    evn = int(ctx.get('evidence', 0))
    rev = ctx.get('reversible', True)
    auto = bool(ctx.get('auto', AUTO_EXECUTE))
    req = required_level(action)
    cur = current_level()
    need_sig = (req > cur and req >= 3)
    ask = (level == 'HIGH' and not auto and not rev)
    rep = ('[meta-reason]' + chr(10) + ' - action: ' + str(action) + chr(10) + ' - level: ' + level + chr(10) + ' - req/cur: ' + str(req) + '/' + str(cur) + chr(10) + ' - 证据数: ' + str(evn) + chr(10) + ' - AUTO_EXECUTE: ' + str(auto) + chr(10) + ' - 可逆: ' + str(rev) + chr(10) + ' - 需签名: ' + ('yes' if need_sig else 'no') + chr(10) + ' - 该问人: ' + ('yes' if ask else 'no'))
    append_meta_log('meta-gate', {'action': action, 'level': level, 'req': req, 'cur': cur, 'ask': ask, 'need_sig': need_sig})
    # 人类在环：LEVEL3 动作需授权签名，soft 模式下也阻塞
    if need_sig:
        return False, rep
    # hard 模式：HIGH 动作也需确认
    if META_LEVEL == 'hard' and ask:
        return False, rep
    return True, rep


def budget_tick(kind):
    b = META_BUDGET
    if not b['active']:
        b['active'] = True
        b['t0'] = time.time()
        b['llm'] = 0
        b['proc'] = 0
    if kind == 'llm': b['llm'] += 1
    elif kind == 'proc': b['proc'] += 1
    elapsed = time.time() - b['t0']
    hit = (elapsed > MAX_SECONDS or b['llm'] > MAX_LLM_CALLS or b['proc'] > MAX_SUB_PROC)
    if hit:
        rep = '[budget] 超预算: %.0fs / llm=%d / proc=%d' % (elapsed, b['llm'], b['proc'])
        append_meta_log('budget-hit', {'elapsed': elapsed})
        return True, rep
    return False, ''


def budget_reset():
    b = META_BUDGET
    b['active'] = False
    b['t0'] = 0
    b['llm'] = 0
    b['proc'] = 0


def compare_failure_mode(expected, actual):
    e = (expected or '').strip().lower()
    a = (actual or '').strip().lower()
    if not e:
        return True, ''
    ok = (e in a) or (a in e)
    if not ok:
        append_meta_log('expect-mismatch', {'expected': e, 'actual': a})
        return False, '期望: ' + e + ' / 实得: ' + a
    return True, ''

def _normalize_fenced_to_tags(text):
    if not isinstance(text, str) or not text:
        return text
    LB = chr(91)
    RB = chr(93)
    BT = chr(96) * 3
    OP = LB + 'script:' + RB
    CL = LB + '/script' + RB
    out = []
    i = 0
    n = len(text)
    while i < n:
        j = text.find(BT, i)
        if j < 0:
            out.append(text[i:])
            break
        k = j + 3
        while k < n and text[k] != chr(10):
            k += 1
        if k >= n:
            out.append(text[i:])
            break
        k += 1
        e = text.find(BT, k)
        if e < 0:
            out.append(text[i:])
            break
        code = text[k:e]
        block = text[j:e+3]
        if (OP in code) or (CL in code):
            out.append(text[i:j])
            out.append(block)
        else:
            out.append(text[i:j])
            out.append(OP + chr(10) + code.rstrip() + chr(10) + CL)
        i = e + 3
    return ''.join(out)
# ============================================================
# RAIN 补丁区 v6.3（由 Rain 追加；不修改上方原函数体）
# 1. THINK/SEARCH 开关持久化（写 mind/config.json，增量不动 api_key/model）
# 2. 请求前在最后一条 user 消息首行注入 [[RAIN_OPTS think=X search=Y]]
# 3. /websearch on|off|1|0|开启|关闭 命令切换联网搜索
# 4. main 启动时恢复开关
# ============================================================

import json as _pj
import os as _po

try:
    SEARCH_ENABLED
except NameError:
    SEARCH_ENABLED = False


def _rain_switches_path():
    return _po.path.join(MIND_DIR, "config.json")


def load_switches():
    global THINK_ENABLED, SEARCH_ENABLED
    try:
        p = _rain_switches_path()
        if not _po.path.exists(p):
            return {"think": bool(THINK_ENABLED), "search": bool(SEARCH_ENABLED)}
        with open(p, "r", encoding="utf-8") as f:
            cfg = _pj.load(f)
        if isinstance(cfg, dict):
            if "think" in cfg:
                THINK_ENABLED = bool(cfg.get("think"))
            if "search" in cfg:
                SEARCH_ENABLED = bool(cfg.get("search"))
    except Exception as e:
        print("[switches] load failed: %s" % e)
    return {"think": bool(THINK_ENABLED), "search": bool(SEARCH_ENABLED)}


def save_switches(think=None, search=None):
    global THINK_ENABLED, SEARCH_ENABLED
    if think is not None:
        THINK_ENABLED = bool(think)
    if search is not None:
        SEARCH_ENABLED = bool(search)
    try:
        p = _rain_switches_path()
        cfg = {}
        if _po.path.exists(p):
            try:
                with open(p, "r", encoding="utf-8") as f:
                    raw = _pj.load(f)
                if isinstance(raw, dict):
                    cfg = raw
            except Exception:
                cfg = {}
        cfg["think"] = bool(THINK_ENABLED)
        cfg["search"] = bool(SEARCH_ENABLED)
        _po.makedirs(_po.path.dirname(p), exist_ok=True)
        with open(p, "w", encoding="utf-8") as f:
            _pj.dump(cfg, f, ensure_ascii=False, indent=2)
        return {"ok": True, "think": THINK_ENABLED, "search": SEARCH_ENABLED}
    except Exception as e:
        return {"ok": False, "err": str(e)}


def _rain_opts_prefix():
    return ("[[RAIN_OPTS think=%d search=%d]]" + chr(10)) % (
        1 if THINK_ENABLED else 0, 1 if SEARCH_ENABLED else 0)


def _rain_inject_opts(msgs):
    if not msgs:
        return msgs
    try:
        if isinstance(msgs[-1], dict) and msgs[-1].get("role") == "user":
            c0 = msgs[-1].get("content") or ""
            if not c0.startswith("[[RAIN_OPTS"):
                m0 = dict(msgs[-1])
                m0["content"] = _rain_opts_prefix() + c0
                out = list(msgs)
                out[-1] = m0
                return out
    except Exception:
        pass
    return msgs


# ---- 包装 _post_stream / _post ----
try:
    _rain_orig_post_stream = _post_stream
    _rain_orig_post = _post

    def _post_stream(msgs, temperature=0.3):
        try:
            msgs = _rain_inject_opts(msgs)
        except Exception:
            pass
        return _rain_orig_post_stream(msgs, temperature)

    def _post(msgs, temperature=0.3):
        try:
            msgs = _rain_inject_opts(msgs)
        except Exception:
            pass
        return _rain_orig_post(msgs, temperature)
except NameError:
    pass


# ---- 包装 main ----
try:
    _rain_orig_main = main

    def main():
        try:
            load_switches()
        except Exception as e:
            print("[switches] restore failed: %s" % e)
        return _rain_orig_main()
except NameError:
    pass


# ---- /websearch 命令 ----
def _rain_handle_websearch(u):
    s = (u or "").strip().lower()
    m = s.split(None, 1)
    if len(m) < 2:
        st = "开启" if SEARCH_ENABLED else "关闭"
        print("联网搜索当前：%s（用法：/websearch on|off）" % st)
        return True
    arg = m[1].strip()
    on_words = ("on", "1", "true", "开启", "开", "启用")
    off_words = ("off", "0", "false", "关闭", "关", "停用")
    if arg in on_words:
        r = save_switches(search=True)
        print("联网搜索已开启" if r.get("ok") else ("保存失败: %s" % r.get("err")))
        return True
    if arg in off_words:
        r = save_switches(search=False)
        print("联网搜索已关闭" if r.get("ok") else ("保存失败: %s" % r.get("err")))
        return True
    print("未知参数：%s（用法：/websearch on|off）" % arg)
    return True


try:
    _rain_orig_handle_command = handle_command

    def handle_command(u):
        if (u or "").strip().lower().startswith("/websearch"):
            return _rain_handle_websearch(u)
        return _rain_orig_handle_command(u)
except NameError:
    pass


# ============================================================
# CLI entry (placed at EOF so every name used by main() exists)
# ============================================================
if __name__ == "__main__":
 main()

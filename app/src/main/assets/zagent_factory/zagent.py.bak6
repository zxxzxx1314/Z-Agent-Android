_LAST_API_ERROR = ""


def _free_proxy_call(target_url, payload):
    msgs = payload.get("messages", [])
    if not msgs:
        return None
    sys_text = ""
    conv = []
    for m in msgs:
        r = m.get("role")
        c = m.get("content") or ""
        if not c:
            continue
        if r == "system":
            if sys_text:
                sys_text = sys_text + "\n\n" + c
            else:
                sys_text = c
        elif r == "user" or r == "assistant":
            conv.append((r, c))
    if len(conv) > 6:
        conv = conv[-6:]
    L = []
    if sys_text:
        L.append("===== 系统设定（最高优先级，必须严格遵守） =====")
        L.append(sys_text.strip())
        L.append("===== 系统设定结束 =====")
        L.append("")
    L.append("===== 对话历史 =====")
    for r, c in conv[:-1]:
        tag = "【用户】" if r == "user" else "【助手】"
        L.append(tag + c)
    if conv:
        L.append("===== 当前输入 =====")
        L.append(conv[-1][1])
    L.append("")
    L.append("===== 强制要求 =====")
    L.append("你现在是 Z-Agent（Android 本地 AI Agent），不是普通聊天助手。")
    L.append("必须严格按上面系统设定的工具调用格式输出（文件写入/读取/执行等指令）。")
    L.append("禁止回复「我是语言模型」「无法操作文件」之类的拒绝话语。直接输出指令。")
    prompt = "\n".join(L)
    if len(prompt) > 12000:
        prompt = prompt[:12000] + "\n[上下文已截断，请基于以上内容作答]"
    global _LAST_API_ERROR
    try:
        from java import jclass
        WebAiBridge = jclass("cn.rain.zagent.WebAiBridge")
        try:
            _inst = WebAiBridge.INSTANCE
        except AttributeError:
            _inst = WebAiBridge.getINSTANCE()
        res = _inst.sendAndWait(prompt)
        res = _normalize_fenced_to_tags(res)
        if isinstance(res, str) and res.startswith("ERROR:"):
            _LAST_API_ERROR = res[6:].strip() if len(res) > 6 else "unknown"
            print("[free] " + _LAST_API_ERROR)
            return None
        _LAST_API_ERROR = ""
        if isinstance(res, str) and res.startswith("T_SEP"):
            parts = res.split("C_SEP", 1)
            th = parts[0][6:]
            ct = parts[1] if len(parts) > 1 else ""
            return {"choices": [{"message": {"content": ct, "reasoning_content": th}}]}
        return {"choices": [{"message": {"content": res}}]}
    except Exception as e:
        _LAST_API_ERROR = "bridge: " + str(e)
        print("[free] " + _LAST_API_ERROR)
        return None


def _free_extract(obj):
    if not isinstance(obj, dict):
        return "", ""
    for k in ("content", "text", "message", "reply", "data"):
        v = obj.get(k)
        if isinstance(v, str) and v:
            return v, ""
    if "choices" in obj:
        try:
            msg = obj["choices"][0]["message"]
            return (msg.get("content") or "",
                    msg.get("reasoning_content") or "")
        except Exception:
            pass
    return "", ""

def _thinking_params_for(base_url):
    """按 BASE_URL 判断厂商，返回思考参数 dict。未知厂商返回 {}。"""
    b = (base_url or "").lower()
    if not b:
        return {}
    if ("deepseek" in b) or ("volces" in b) or ("siliconflow" in b) or ("sglang" in b):
        return {"thinking": {"type": "enabled"}}
    if ("bigmodel" in b) or ("zhipu" in b) or ("glm" in b) or ("chatglm" in b):
        return {"thinking": {"type": "enabled"}}
    if ("dashscope" in b) or ("aliyun" in b) or ("qwen" in b) or ("bailian" in b):
        return {"enable_thinking": True}
    if ("openai" in b) or ("azure" in b):
        return {"reasoning_effort": "medium"}
    return {"thinking": {"type": "enabled"}}

def _apply_thinking(payload):
    if not THINK_ENABLED:
        return payload
    extra = _thinking_params_for(BASE_URL)
    if extra:
        payload.update(extra)
    return payload

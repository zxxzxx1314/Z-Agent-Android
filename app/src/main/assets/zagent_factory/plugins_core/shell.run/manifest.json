{
"id": "shell.run",
"name": "执行命令",
"desc": "在 sh -c 下执行命令，返回 stdout/stderr/退出码；stdout 与 stderr 各截断到 64 KiB。子进程隔离。",
"version": "1.1",
"level": 2,
"permission": ["shell"],
"isolation": "process",
"timeout": 120,
"tags": ["core", "shell"],
"args": {
"cmd": {"type": "string", "required": true},
"timeout": {"type": "int", "default": 120, "desc": "秒，1..3600"},
"cwd": {"type": "string", "default": "", "desc": "工作目录"}
},
"returns": {"ok": "bool", "outcome": "ok|failed|unknown|not_submitted", "data": "rc/out/err", "out_limit": "65536 bytes each"}
}

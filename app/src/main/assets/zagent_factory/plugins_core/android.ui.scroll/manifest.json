{
 "id": "android.ui.scroll",
 "name": "scroll",
 "desc": "Scroll by direction via root input swipe",
 "version": "1.0",
 "level": 2,
 "permission": ["root"],
 "isolation": "inproc",
 "timeout": 40,
 "tags": ["android", "ui"],
 "args": {
 "direction": {"type": "string", "default": "down"},
 "amount": {"type": "float", "default": 0.6},
 "duration_ms": {"type": "int", "default": 300}
 },
 "requires": {"root": "REQUIRED"}
}

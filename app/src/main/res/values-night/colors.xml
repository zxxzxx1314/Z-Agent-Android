<?xml version="1.0" encoding="utf-8"?>
<!-- Z-Agent 语义化 design token · 深色主题
深色不纯黑，三层靠抬升分界 -->
<resources>

<!-- ===== 背景层次 ===== -->
<color name="bg_canvas">#0F0F12</color> <!-- 页面底 · 墨黑 -->
<color name="bg_elevated">#1A1A20</color> <!-- 抬高一档 -->
<color name="bg_subtle">#24242C</color> <!-- 再高一档 -->

<!-- ===== 文字（避免纯白刺眼）===== -->
<color name="text_primary">#ECECF1</color>
<color name="text_secondary">#9A9AA8</color>
<color name="text_tertiary">#8A8A98</color>

<!-- ===== 主色 ===== -->
<color name="accent">#9B7FFF</color> <!-- 深色下提亮 -->
<color name="accent_subtle">#1A9B7FFF</color> <!-- 主色 10% -->
<color name="accent_line">#4D9B7FFF</color> <!-- 主色 30% · 深色描边更明显 -->

<!-- ===== 主色上的文字（深色下用墨色，保对比）===== -->
<color name="on_accent">#0F0F12</color>
<color name="on_user_bubble">#0F0F12</color>

<!-- ===== 语义色 ===== -->
<color name="ok">#3FB950</color>
<color name="warn">#D29922</color>
<color name="danger">#F85149</color>

<!-- ===== 兼容别名 ===== -->
<color name="bg_root">@color/bg_canvas</color>
<color name="bg_surface">@color/bg_elevated</color>
<color name="bg_input">@color/bg_subtle</color>
<color name="divider">@color/accent_line</color>
<color name="status_bar">@color/bg_elevated</color>
<color name="chip_bg_selected">@color/accent_subtle</color>
<color name="chip_stroke">@color/accent_line</color>
<color name="card_stroke">@color/accent_line</color>
<color name="send_pressed">@color/accent</color>
<color name="text_on_accent">@color/on_accent</color>
<color name="btn_shadow">#00000000</color>
</resources>
<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg_canvas" android:orientation="vertical" android:paddingStart="18dp" android:paddingEnd="18dp" android:paddingTop="28dp" android:paddingBottom="18dp">
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="应用崩溃了" android:textColor="@color/text_primary" android:textSize="22sp" android:textStyle="bold" />
<TextView android:id="@+id/crashSub" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:ellipsize="end" android:maxLines="3" android:text="未捕获异常" android:textColor="@color/text_secondary" android:textSize="13sp" />
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="日志已保存，可复制后反馈。" android:textColor="@color/text_tertiary" android:textSize="11sp" />
<ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="14dp" android:background="@color/bg_subtle" android:padding="12dp">
<TextView android:id="@+id/crashText" android:layout_width="match_parent" android:layout_height="wrap_content" android:textIsSelectable="true" android:textColor="@color/text_primary" android:textSize="11sp" android:typeface="monospace" />
</ScrollView>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:gravity="end" android:orientation="horizontal">
<TextView android:id="@+id/crashExit" android:layout_width="wrap_content" android:layout_height="36dp" android:background="@drawable/bg_quick" android:clickable="true" android:focusable="true" android:gravity="center" android:paddingStart="14dp" android:paddingEnd="14dp" android:text="退出" android:textColor="@color/text_secondary" android:textSize="13sp" />
<TextView android:id="@+id/crashCopy" android:layout_width="wrap_content" android:layout_height="36dp" android:layout_marginStart="8dp" android:background="@drawable/bg_quick" android:clickable="true" android:focusable="true" android:gravity="center" android:paddingStart="14dp" android:paddingEnd="14dp" android:text="复制" android:textColor="@color/text_primary" android:textSize="13sp" />
<TextView android:id="@+id/crashShare" android:layout_width="wrap_content" android:layout_height="36dp" android:layout_marginStart="8dp" android:background="@drawable/bg_quick" android:clickable="true" android:focusable="true" android:gravity="center" android:paddingStart="14dp" android:paddingEnd="14dp" android:text="分享" android:textColor="@color/text_primary" android:textSize="13sp" />
<TextView android:id="@+id/crashRestart" android:layout_width="wrap_content" android:layout_height="36dp" android:layout_marginStart="8dp" android:background="@drawable/bg_circle_send" android:clickable="true" android:focusable="true" android:gravity="center" android:paddingStart="14dp" android:paddingEnd="14dp" android:text="重启应用" android:textColor="@color/on_accent" android:textSize="13sp" />
</LinearLayout>
</LinearLayout>

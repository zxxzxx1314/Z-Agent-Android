<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
android:id="@+id/rootView" android:clipChildren="false" android:clipToPadding="false"
android:layout_width="match_parent"
android:layout_height="match_parent"
android:background="@color/bg_canvas"
android:orientation="vertical">

<!-- 顶栏 -->
<LinearLayout
android:id="@+id/topBar"
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:background="@color/bg_elevated"
android:gravity="center_vertical"
android:orientation="horizontal"
android:paddingStart="18dp"
android:paddingTop="10dp"
android:paddingEnd="8dp"
android:paddingBottom="10dp">

<LinearLayout
android:layout_width="0dp"
android:layout_height="wrap_content"
android:layout_weight="1"
android:orientation="vertical">
<TextView
android:layout_width="wrap_content"
android:layout_height="wrap_content"
android:text="Z-Agent"
android:textColor="@color/text_primary"
android:fontFamily="sans-serif-medium"
android:textSize="18sp" />
<TextView
android:id="@+id/statusText"
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:layout_marginTop="3dp"
android:ellipsize="end"
android:maxLines="1"
android:text="正在连接……"
android:textColor="@color/text_tertiary"
android:textSize="@dimen/fs_caption" />
</LinearLayout>

<!-- 主题切换（太阳/月亮）ghost -->
<FrameLayout
android:id="@+id/themeButton"
android:contentDescription="切换深浅主题"
android:layout_width="48dp"
android:layout_height="48dp"
android:background="?attr/selectableItemBackgroundBorderless"
android:clickable="true"
android:focusable="true">
<ImageView
android:id="@+id/themeIcon"
android:layout_width="22dp"
android:layout_height="22dp"
android:layout_gravity="center"
android:src="@drawable/ic_moon" />
</FrameLayout>

<!-- 设置齿轮 ghost -->
<FrameLayout
android:id="@+id/settingsButton"
android:contentDescription="打开设置"
android:layout_width="48dp"
android:layout_height="48dp"
android:background="?attr/selectableItemBackgroundBorderless"
android:clickable="true"
android:focusable="true">
<ImageView
android:layout_width="22dp"
android:layout_height="22dp"
android:layout_gravity="center"
android:src="@drawable/ic_gear" />
</FrameLayout>
</LinearLayout>

<!-- 对话区 -->
<FrameLayout android:clipChildren="false" android:clipToPadding="false"
android:layout_width="match_parent"
android:layout_height="0dp"
android:layout_weight="1">

<ScrollView
android:id="@+id/outputScroll"
android:layout_width="match_parent"
android:layout_height="match_parent"
android:background="@color/bg_canvas"
android:fillViewport="true"
android:overScrollMode="always"
android:scrollbars="vertical">
<LinearLayout
android:id="@+id/chatContainer"
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:orientation="vertical"
android:paddingStart="8dp"
android:paddingTop="12dp"
android:paddingEnd="8dp"
android:paddingBottom="96dp">

<LinearLayout
android:id="@+id/emptyState"
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:gravity="center_horizontal"
android:orientation="vertical"
android:paddingTop="48dp"
android:paddingBottom="24dp">
<TextView
android:layout_width="wrap_content"
android:layout_height="wrap_content"
android:text="✻"
android:textColor="@color/accent"
android:textSize="@dimen/fs_display"
android:textStyle="bold" />
<TextView
android:layout_width="wrap_content"
android:layout_height="wrap_content"
android:layout_marginTop="8dp"
android:text="开始一段新对话"
android:textColor="@color/text_primary"
android:textSize="@dimen/fs_title"
android:textStyle="bold" />
<TextView
android:layout_width="wrap_content"
android:layout_height="wrap_content"
android:layout_marginTop="4dp"
android:text="输入消息开始对话"
android:textColor="@color/text_secondary"
android:textSize="@dimen/fs_caption" />
<!-- Prompt 快捷卡片 -->
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:orientation="vertical" android:paddingStart="8dp" android:paddingEnd="8dp">

<TextView android:id="@+id/promptCard1" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_prompt_card" android:clickable="true" android:focusable="true" android:paddingStart="14dp" android:paddingTop="12dp" android:paddingEnd="14dp" android:paddingBottom="12dp" android:text="帮我写一份本周工作周报（计划模式）" android:textColor="@color/text_primary" android:textSize="@dimen/fs_body" />

<TextView android:id="@+id/promptCard2" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@drawable/bg_prompt_card" android:clickable="true" android:focusable="true" android:paddingStart="14dp" android:paddingTop="12dp" android:paddingEnd="14dp" android:paddingBottom="12dp" android:text="解释这段代码的逻辑（构建模式）" android:textColor="@color/text_primary" android:textSize="@dimen/fs_body" />

<TextView android:id="@+id/promptCard3" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@drawable/bg_prompt_card" android:clickable="true" android:focusable="true" android:paddingStart="14dp" android:paddingTop="12dp" android:paddingEnd="14dp" android:paddingBottom="12dp" android:text="深度分析并总结这篇文档（深度思考）" android:textColor="@color/text_primary" android:textSize="@dimen/fs_body" />
</LinearLayout>
</LinearLayout>
 </LinearLayout>
</ScrollView>

<!-- 回到底部悬浮钮 -->
<FrameLayout
android:id="@+id/scrollBottomBtn"
android:layout_width="40dp"
android:layout_height="40dp"
android:layout_gravity="bottom|end"
android:layout_marginEnd="16dp"
 android:layout_marginBottom="76dp"
android:background="@drawable/bg_circle_btn"
android:clickable="true"
android:focusable="true"
android:foreground="@drawable/ripple_circle"
android:visibility="gone">
<TextView
android:layout_width="wrap_content"
android:layout_height="wrap_content"
android:layout_gravity="center"
android:text="↓"
android:textColor="@color/accent"
android:textSize="20sp"
android:textStyle="bold" />
</FrameLayout>
<!-- 收起态：浮动圆钮，锚在对话区右下 -->
<FrameLayout android:id="@+id/quickToggleCollapsed" android:layout_width="28dp" android:layout_height="48dp" android:layout_gravity="bottom|end" android:layout_marginEnd="0dp" android:layout_marginBottom="8dp" android:background="@drawable/bg_edge_pill" android:clickable="true" android:focusable="true" android:foreground="@drawable/ripple_pill" android:visibility="gone" android:elevation="4dp">
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:text="‹" android:textColor="@color/accent" android:textSize="22sp" android:textStyle="bold" />
</FrameLayout>
</FrameLayout>

<!-- 快捷条（可收起/展开/自定义） -->
<LinearLayout android:id="@+id/quickBarContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@color/bg_elevated" android:orientation="vertical">

<!-- 展开态：按钮排 --> <LinearLayout android:id="@+id/quickRowWrap" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:minHeight="56dp" android:orientation="horizontal" android:paddingStart="8dp" android:paddingTop="6dp" android:paddingEnd="8dp" android:paddingBottom="6dp"> <HorizontalScrollView android:id="@+id/quickScroll" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:overScrollMode="never" android:scrollbars="none"> <LinearLayout android:id="@+id/quickRow" android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="8dp" android:paddingEnd="8dp" /> </HorizontalScrollView> <TextView android:id="@+id/quickCollapse" android:layout_width="40dp" android:layout_height="40dp" android:layout_marginStart="4dp" android:background="@drawable/bg_quick" android:clickable="true" android:focusable="true" android:foreground="@drawable/ripple_pill" android:gravity="center" android:text="▾" android:textColor="@color/text_primary" android:textSize="16sp" /> </LinearLayout> <!-- 编辑提示条 --> <LinearLayout android:id="@+id/quickEditBar" android:layout_width="match_parent" android:layout_height="36dp" android:background="@color/bg_subtle" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="16dp" android:paddingEnd="12dp" android:visibility="gone"> <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="拖动排序 · 点×移除 · 点＋添加" android:textColor="@color/text_secondary" android:textSize="11sp" /> <TextView android:id="@+id/quickEditDone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingStart="12dp" android:paddingEnd="4dp" android:text="完成" android:textColor="@color/accent" android:textSize="13sp" android:textStyle="bold" /> </LinearLayout> </LinearLayout>

<!-- 输入区 -->
<LinearLayout android:id="@+id/inputBar" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@color/bg_canvas" android:clipChildren="false" android:clipToPadding="false" android:orientation="vertical" android:paddingStart="12dp" android:paddingTop="6dp" android:paddingEnd="12dp" android:paddingBottom="14dp">

<!-- 模式 chips（移出输入框）-->

<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:paddingBottom="8dp">

<FrameLayout android:id="@+id/segContainer" android:layout_width="wrap_content" android:layout_height="36dp" android:background="@drawable/bg_seg_container" android:padding="2dp">
<View android:id="@+id/segThumb" android:layout_width="0dp" android:layout_height="match_parent" android:background="@drawable/bg_seg_thumb" />
<LinearLayout android:layout_width="wrap_content" android:layout_height="match_parent" android:orientation="horizontal">
<TextView android:id="@+id/segPlan" android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center" android:paddingStart="14dp" android:paddingEnd="14dp" android:text="计划" android:textColor="@color/text_secondary" android:textSize="@dimen/fs_label" />
<TextView android:id="@+id/segBuild" android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center" android:paddingStart="14dp" android:paddingEnd="14dp" android:text="构建" android:textColor="@color/accent" android:textSize="@dimen/fs_label" />
</LinearLayout>
</FrameLayout>

<TextView android:id="@+id/chipThink2" android:layout_width="wrap_content" android:layout_height="36dp" android:layout_marginStart="8dp" android:background="@drawable/bg_mini_pill" android:clickable="true" android:focusable="true" android:foreground="@drawable/ripple_pill" android:gravity="center" android:paddingStart="14dp" android:paddingEnd="14dp" android:text="✻ 深度思考" android:textColor="@color/text_secondary" android:textSize="@dimen/fs_label" android:maxLines="1" android:singleLine="true" />

<TextView android:id="@+id/chipSearch" android:layout_width="wrap_content" android:layout_height="36dp" android:visibility="gone" />

<View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
</LinearLayout>

<!-- 输入卡 -->

<LinearLayout android:id="@+id/inputCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:layout_marginBottom="2dp" android:background="@drawable/bg_input_card" android:elevation="6dp" android:orientation="vertical" android:paddingStart="14dp" android:paddingTop="10dp" android:paddingEnd="10dp" android:paddingBottom="8dp">

<HorizontalScrollView android:id="@+id/attachScroll" android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none" android:visibility="gone">
<LinearLayout android:id="@+id/attachRow" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingBottom="6dp" />
</HorizontalScrollView>

<EditText android:id="@+id/inputEdit" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="44dp" android:background="@null" android:hint="输入消息..." android:imeOptions="actionSend" android:inputType="textCapSentences" android:maxLines="5" android:paddingTop="8dp" android:paddingBottom="4dp" android:textColor="@color/text_primary" android:textColorHint="@color/text_tertiary" android:textSize="@dimen/fs_body" />

<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical|end" android:orientation="horizontal">

<FrameLayout android:id="@+id/btnPlus" android:contentDescription="添加附件" android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/bg_circle_btn" android:clickable="true" android:focusable="true" android:foreground="@drawable/ripple_circle">
<ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center" android:src="@drawable/ic_plus" />
</FrameLayout>

<FrameLayout android:id="@+id/sendButton" android:contentDescription="发送消息" android:layout_width="40dp" android:layout_height="40dp" android:layout_marginStart="8dp" android:background="@drawable/bg_circle_send" android:clickable="true" android:focusable="true" android:foreground="@drawable/ripple_circle">
<ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center" android:src="@drawable/ic_arrow_up" />
</FrameLayout>
</LinearLayout>
</LinearLayout>

</LinearLayout> </LinearLayout>
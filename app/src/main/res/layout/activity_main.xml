<?xml version="1.0" encoding="utf-8"?>
<!--
    Z-Agent 主界面
    1. 顶栏：标题 + 状态 + 浅色/深色切换
    2. 中部：气泡对话区
    3. 底部：快捷按钮条（含设置）+ 输入栏
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_root"
    android:orientation="vertical">

    <!-- ============ 顶部标题栏 ============ -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="10dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Z-Agent"
                android:textColor="@color/text_primary"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/statusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="正在连接……"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/themeButton"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/bg_quick"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="浅色"
            android:textColor="@color/accent"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- ============ 对话区 ============ -->
    <ScrollView
        android:id="@+id/outputScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="vertical">

        <LinearLayout
            android:id="@+id/chatContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingTop="12dp"
            android:paddingEnd="8dp"
            android:paddingBottom="12dp" />
    </ScrollView>

    <!-- ============ 底部快捷按钮条（含设置） ============ -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_surface"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="4dp">

            <TextView android:id="@+id/btnIdle" android:layout_width="wrap_content" android:layout_height="30dp" android:background="@drawable/bg_quick" android:gravity="center" android:paddingStart="12dp" android:paddingEnd="12dp" android:text="自主" android:textColor="@color/text_secondary" android:textSize="12sp" />
            <TextView android:id="@+id/btnContract" android:layout_width="wrap_content" android:layout_height="30dp" android:layout_marginStart="6dp" android:background="@drawable/bg_quick" android:gravity="center" android:paddingStart="12dp" android:paddingEnd="12dp" android:text="合同" android:textColor="@color/text_secondary" android:textSize="12sp" />
            <TextView android:id="@+id/btnVersions" android:layout_width="wrap_content" android:layout_height="30dp" android:layout_marginStart="6dp" android:background="@drawable/bg_quick" android:gravity="center" android:paddingStart="12dp" android:paddingEnd="12dp" android:text="版本" android:textColor="@color/text_secondary" android:textSize="12sp" />
            <TextView android:id="@+id/btnHelp" android:layout_width="wrap_content" android:layout_height="30dp" android:layout_marginStart="6dp" android:background="@drawable/bg_quick" android:gravity="center" android:paddingStart="12dp" android:paddingEnd="12dp" android:text="帮助" android:textColor="@color/text_secondary" android:textSize="12sp" />
            <TextView android:id="@+id/btnPlugins" android:layout_width="wrap_content" android:layout_height="30dp" android:layout_marginStart="6dp" android:background="@drawable/bg_quick" android:gravity="center" android:paddingStart="12dp" android:paddingEnd="12dp" android:text="插件" android:textColor="@color/text_secondary" android:textSize="12sp" />
            <TextView android:id="@+id/btnSavePlugin" android:layout_width="wrap_content" android:layout_height="30dp" android:layout_marginStart="6dp" android:background="@drawable/bg_quick" android:gravity="center" android:paddingStart="12dp" android:paddingEnd="12dp" android:text="存插件" android:textColor="@color/text_secondary" android:textSize="12sp" />
            <TextView android:id="@+id/btnClear" android:layout_width="wrap_content" android:layout_height="30dp" android:layout_marginStart="6dp" android:background="@drawable/bg_quick" android:gravity="center" android:paddingStart="12dp" android:paddingEnd="12dp" android:text="清屏" android:textColor="@color/text_secondary" android:textSize="12sp" />
            <TextView android:id="@+id/settingsButton" android:layout_width="wrap_content" android:layout_height="30dp" android:layout_marginStart="6dp" android:background="@drawable/bg_quick" android:gravity="center" android:paddingStart="12dp" android:paddingEnd="12dp" android:text="设置" android:textColor="@color/accent" android:textSize="12sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- ============ 底部输入栏（含自动执行开关） ============ -->
    <LinearLayout
        android:id="@+id/inputBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_surface"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="6dp"
        android:paddingEnd="14dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="自动执行（免确认）"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <android.widget.Switch
                android:id="@+id/autoSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:checked="true"
                android:minHeight="0dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/inputEdit"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input"
                android:hint="输入消息，或点下方按钮"
                android:imeOptions="actionSend"
                android:inputType="textMultiLine|text"
                android:maxLines="4"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="14sp" />

            <Button
                android:id="@+id/sendButton"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_send"
                android:paddingStart="22dp"
                android:paddingEnd="22dp"
                android:stateListAnimator="@null"
                android:text="发送"
                android:textAllCaps="false"
                android:textColor="@color/text_on_accent"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
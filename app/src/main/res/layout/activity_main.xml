<?xml version="1.0" encoding="utf-8"?>
<!-- Z-Agent：顶部标题栏 / 对话区 / 快捷条 / 输入卡片 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_root"
    android:orientation="vertical">

    <!-- ============ 顶部标题栏 ============ -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="10dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Z-Agent"
                android:textColor="@color/text_primary"
                android:textSize="19sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/statusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="正在连接……"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/themeButton"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/bg_quick"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="浅色"
            android:textColor="@color/accent"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/settingsButton"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_quick"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="设置"
            android:textColor="@color/accent"
            android:textSize="13sp" />
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" />

    <!-- ============ 对话区 ============ -->
    <ScrollView
        android:id="@+id/outputScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/bg_root"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="vertical">
        <LinearLayout
            android:id="@+id/chatContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingTop="12dp"
            android:paddingEnd="8dp"
            android:paddingBottom="12dp" />
    </ScrollView>

    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" />

    <!-- ============ 快捷按钮条 ============ -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_surface"
        android:overScrollMode="never"
        android:scrollbars="none">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp">
            <TextView android:id="@+id/btnIdle" android:layout_width="wrap_content" android:layout_height="30dp" android:background="@drawable/bg_quick" android:gravity="center" android:paddingStart="12dp" android:paddingEnd="12dp" android:text="自主" android:textColor="@color/text_secondary" android:textSize="12sp" />
            <TextView android:id="@+id/btnContract" android:layout_width="wrap_content" android:layout_height="30dp" android:layout_marginStart="6dp" android:background="@drawable/bg_quick" android:gravity="center" android:paddingStart="12dp" android:paddingEnd="12dp" android:text="合同" android:textColor="@color/text_secondary" android:textSize="12sp" />
            <TextView android:id="@+id/btnVersions" android:layout_width="wrap_content" android:layout_height="30dp" android:layout_marginStart="6dp" android:background="@drawable/bg_quick" android:gravity="center" android:paddingStart="12dp" android:paddingEnd="12dp" android:text="版本" android:textColor="@color/text_secondary" android:textSize="12sp" />
            <TextView android:id="@+id/btnHelp" android:layout_width="wrap_content" android:layout_height="30dp" android:layout_marginStart="6dp" android:background="@drawable/bg_quick" android:gravity="center" android:paddingStart="12dp" android:paddingEnd="12dp" android:text="帮助" android:textColor="@color/text_secondary" android:textSize="12sp" />
            <TextView android:id="@+id/btnPlugins" android:layout_width="wrap_content" android:layout_height="30dp" android:layout_marginStart="6dp" android:background="@drawable/bg_quick" android:gravity="center" android:paddingStart="12dp" android:paddingEnd="12dp" android:text="插件" android:textColor="@color/text_secondary" android:textSize="12sp" />
            <TextView android:id="@+id/btnSavePlugin" android:layout_width="wrap_content" android:layout_height="30dp" android:layout_marginStart="6dp" android:background="@drawable/bg_quick" android:gravity="center" android:paddingStart="12dp" android:paddingEnd="12dp" android:text="存插件" android:textColor="@color/text_secondary" android:textSize="12sp" />
            <TextView android:id="@+id/btnClear" android:layout_width="wrap_content" android:layout_height="30dp" android:layout_marginStart="6dp" android:background="@drawable/bg_quick" android:gravity="center" android:paddingStart="12dp" android:paddingEnd="12dp" android:text="清屏" android:textColor="@color/text_secondary" android:textSize="12sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" />

    <!-- ============ 输入卡片（DeepSeek 风格：大圆角卡片 + 分段胶囊 + 圆形按钮） ============ -->
    <LinearLayout
        android:id="@+id/inputBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_surface"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="14dp"
        android:paddingBottom="12dp">

        <!-- 输入卡片 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_input_card"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="10dp"
            android:paddingEnd="12dp"
            android:paddingBottom="10dp">

            <!-- 输入框 -->
            <EditText
                android:id="@+id/inputEdit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="44dp"
                android:background="@null"
                android:hint="输入消息..."
                android:imeOptions="actionSend"
                android:inputType="textMultiLine|text"
                android:maxLines="6"
                android:paddingTop="8dp"
                android:paddingBottom="4dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="15sp" />

            <!-- 卡片底部工具行：分段胶囊 + 深度思考 + 弹簧 + 加号 + 发送 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Plan / Build 分段胶囊 -->
                <LinearLayout
                    android:id="@+id/segContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:background="@drawable/bg_seg_container"
                    android:orientation="horizontal"
                    android:padding="2dp">

                    <TextView
                        android:id="@+id/segPlan"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:background="@null"
                        android:gravity="center"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:text="Plan"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/segBuild"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_seg_thumb"
                        android:gravity="center"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:text="Build"
                        android:textColor="@color/accent"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- 深度思考胶囊 -->
                <TextView
                    android:id="@+id/chipThink2"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_mini_pill"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="深度思考"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <!-- 智能搜索占位：隐藏 -->
                <TextView
                    android:id="@+id/chipSearch"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:visibility="gone"
                    android:text="智能搜索" />

                <!-- 弹簧 -->
                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <!-- 加号圆钮 -->
                <FrameLayout
                    android:id="@+id/btnPlus"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_circle_btn"
                    android:clickable="true"
                    android:focusable="true">
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_plus" />
                </FrameLayout>

                <!-- 圆形发送按钮 -->
                <FrameLayout
                    android:id="@+id/sendButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_circle_send"
                    android:clickable="true"
                    android:focusable="true">
                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_send_arrow" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- 自动执行开关 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="自动执行（免确认）"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
            <android.widget.Switch
                android:id="@+id/autoSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:checked="true"
                android:minHeight="0dp"
                android:scaleX="0.8"
                android:scaleY="0.8" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
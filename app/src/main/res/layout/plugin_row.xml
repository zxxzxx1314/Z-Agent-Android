<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:layout_marginTop="6dp"
android:layout_marginBottom="6dp"
android:background="@drawable/bg_row_card"
android:orientation="vertical"
android:padding="16dp">

<LinearLayout
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:gravity="center_vertical"
android:orientation="horizontal">

<TextView
android:id="@+id/pluginName"
android:layout_width="0dp"
android:layout_height="wrap_content"
android:layout_weight="1"
android:ellipsize="end"
android:singleLine="true"
android:textColor="@color/text_primary"
android:textSize="@dimen/fs_body"
android:textStyle="bold" />

<TextView
android:id="@+id/pluginMtime"
android:layout_width="wrap_content"
android:layout_height="wrap_content"
android:layout_marginStart="8dp"
android:singleLine="true"
android:textColor="@color/text_tertiary"
android:textSize="@dimen/fs_caption" />
</LinearLayout>

<TextView
android:id="@+id/pluginDesc"
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:layout_marginTop="6dp"
android:textColor="@color/text_secondary"
android:textSize="@dimen/fs_label" />

<TextView
android:id="@+id/pluginMeta"
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:layout_marginTop="8dp"
android:singleLine="true"
android:textColor="@color/text_tertiary"
android:textSize="@dimen/fs_caption" />
</LinearLayout>
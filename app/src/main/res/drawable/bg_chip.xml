<?xml version="1.0" encoding="utf-8"?>
<!-- 模式胶囊背景：选中=半透明蓝底+细边，未选=表面色底+灰边 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/chip_bg_selected" />
            <corners android:radius="18dp" />
            <stroke android:width="1dp" android:color="@color/accent" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_input" />
            <corners android:radius="18dp" />
            <stroke android:width="1dp" android:color="@color/chip_stroke" />
        </shape>
    </item>
</selector>

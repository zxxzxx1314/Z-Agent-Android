<?xml version="1.0" encoding="utf-8"?>
<!-- 单一 DayNight 主题；配色随 values/values-night 自动切换 -->
<resources>
<style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
<item name="android:windowBackground">@color/bg_root</item>
<item name="colorPrimary">@color/accent</item>
<item name="colorPrimaryDark">@color/status_bar</item>
<item name="colorAccent">@color/accent</item>
<item name="android:statusBarColor">@color/status_bar</item>
<item name="android:navigationBarColor">@color/status_bar</item>
<item name="android:windowLightStatusBar">@bool/light_status_bar</item>
</style>

<!-- 快捷条小胶囊（带 ripple 按压） -->
<style name="QuickChip">
<item name="android:layout_width">wrap_content</item>
<item name="android:layout_height">30dp</item>
<item name="android:layout_marginStart">6dp</item>
<item name="android:background">@drawable/bg_quick</item>
<item name="android:foreground">@drawable/ripple_press</item>
<item name="android:gravity">center</item>
<item name="android:paddingStart">12dp</item>
<item name="android:paddingEnd">12dp</item>
<item name="android:textColor">@color/text_secondary</item>
<item name="android:textSize">12sp</item>
<item name="android:clickable">true</item>
<item name="android:focusable">true</item>
</style>

<!-- 空状态引导按钮 -->
<style name="EmptyChip">
<item name="android:layout_width">wrap_content</item>
<item name="android:layout_height">wrap_content</item>
<item name="android:layout_gravity">center_horizontal</item>
<item name="android:layout_marginTop">8dp</item>
<item name="android:background">@drawable/bg_quick</item>
<item name="android:foreground">@drawable/ripple_press</item>
<item name="android:paddingStart">18dp</item>
<item name="android:paddingEnd">18dp</item>
<item name="android:paddingTop">10dp</item>
<item name="android:paddingBottom">10dp</item>
<item name="android:textColor">@color/text_primary</item>
<item name="android:textSize">13sp</item>
<item name="android:clickable">true</item>
<item name="android:focusable">true</item>
</style>
</resources>

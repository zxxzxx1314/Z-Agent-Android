<?xml version="1.0" encoding="utf-8"?>
<!-- Z-Agent · DayNight 主题 · 全走 token -->
<resources>

<style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
<item name="android:windowBackground">@color/bg_canvas</item>
<item name="colorPrimary">@color/accent</item>
<item name="colorPrimaryDark">@color/bg_elevated</item>
<item name="colorAccent">@color/accent</item>
<item name="colorControlHighlight">@color/accent_line</item>
<item name="android:statusBarColor">@color/bg_elevated</item>
<item name="android:navigationBarColor">@color/bg_elevated</item>
<item name="android:windowLightStatusBar">@bool/light_status_bar</item>
<item name="android:textColorPrimary">@color/text_primary</item>
<item name="android:textColorSecondary">@color/text_secondary</item>
<item name="android:textColorHint">@color/text_tertiary</item>
<item name="bottomSheetDialogTheme">@style/AppBottomSheet</item>
</style>

<!-- Bottom Sheet：容器透明，圆角由内容背景提供 -->
<style name="AppBottomSheet" parent="Theme.Design.Light.BottomSheetDialog">
<item name="bottomSheetStyle">@style/AppBottomSheet.Modal</item>
<item name="android:windowIsFloating">false</item>
<item name="android:statusBarColor">@android:color/transparent</item>
</style>

<style name="AppBottomSheet.Modal" parent="Widget.Design.BottomSheet.Modal">
<item name="android:background">@android:color/transparent</item>
</style>

<!-- 快捷条小胶囊 -->
<style name="QuickChip">
<item name="android:layout_width">wrap_content</item>
<item name="android:layout_height">@dimen/ctrl_h_sm</item>
<item name="android:layout_marginStart">@dimen/space_sm</item>
<item name="android:background">@drawable/bg_quick</item>
<item name="android:foreground">@drawable/ripple_press</item>
<item name="android:gravity">center</item>
<item name="android:paddingStart">@dimen/pad_pill_h</item>
<item name="android:paddingEnd">@dimen/pad_pill_h</item>
<item name="android:textColor">@color/text_secondary</item>
<item name="android:textSize">@dimen/fs_label</item>
<item name="android:clickable">true</item>
<item name="android:focusable">true</item>
</style>

<!-- 空状态引导按钮 -->
<style name="EmptyChip">
<item name="android:layout_width">wrap_content</item>
<item name="android:layout_height">wrap_content</item>
<item name="android:layout_gravity">center_horizontal</item>
<item name="android:layout_marginTop">@dimen/space_sm</item>
<item name="android:background">@drawable/bg_quick</item>
<item name="android:foreground">@drawable/ripple_press</item>
<item name="android:paddingStart">20dp</item>
<item name="android:paddingEnd">20dp</item>
<item name="android:paddingTop">@dimen/space_md</item>
<item name="android:paddingBottom">@dimen/space_md</item>
<item name="android:textColor">@color/text_primary</item>
<item name="android:textSize">@dimen/fs_label</item>
<item name="android:clickable">true</item>
<item name="android:focusable">true</item>
</style>
</resources>

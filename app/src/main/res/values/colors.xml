<?xml version="1.0" encoding="utf-8"?>
<!-- Z-Agent 语义化 design token · 浅色主题
命名规则：<角色>/<层级> 例 bg/canvas → bg_canvas
修改配色只改这里，布局与代码一律引用 token -->
<resources>

<!-- ===== 背景层次（三层，靠深浅分界，不加描边）===== -->
<color name="bg_canvas">#FAFAF9</color> <!-- 页面底 · 暖白带紫调 -->
<color name="bg_elevated">#FFFFFF</color> <!-- 卡片/气泡浮层 -->
<color name="bg_subtle">#F4F2F9</color> <!-- 输入框/胶囊底 -->

<!-- ===== 文字（三档，全部带紫调）===== -->
<color name="text_primary">#1A1A24</color>
<color name="text_secondary">#6D6D7A</color>
<color name="text_tertiary">#9E9EAB</color>

<!-- ===== 主色 ===== -->
<color name="accent">#6D4AFF</color> <!-- 浅色下加深保对比度 -->
<color name="accent_subtle">#146D4AFF</color> <!-- 主色 8% · 聚焦态/用户气泡底 -->
<color name="accent_line">#1F6D4AFF</color> <!-- 主色 12% · 必须描边时用 -->

<!-- ===== 主色上的文字 ===== -->
<color name="on_accent">#FFFFFF</color>
<color name="on_user_bubble">#FFFFFF</color>

<!-- ===== 语义色（保留）===== -->
<color name="ok">#2E7D32</color>
<color name="warn">#B26A00</color>
<color name="danger">#C62828</color>

<!-- ===== 兼容别名（旧名 → 新 token，逐步淘汰）===== -->
<color name="bg_root">@color/bg_canvas</color>
<color name="bg_surface">@color/bg_elevated</color>
<color name="bg_input">@color/bg_subtle</color>
<color name="divider">@color/accent_line</color>
<color name="status_bar">@color/bg_elevated</color>
<color name="chip_bg_selected">@color/accent_subtle</color>
<color name="chip_stroke">@color/accent_line</color>
<color name="card_stroke">@color/accent_line</color>
<color name="send_pressed">@color/accent</color>
<color name="text_on_accent">@color/on_accent</color>
<color name="btn_shadow">#00000000</color> <!-- 投影已废弃，置透明 -->
</resources>
